-- Exhaustiveness checking of pattern matches.
module Ark.Exhaust

import Ark.Util (..)
import Ark.Ast (..)
import Ark.Types (..)
import Std.Map as Map

-- A constructor for the analysis: name, short name, arity, type name.
type SCon = SCon String String Int String

sconName : SCon -> String
sconName (SCon n _ _ _) = n

sconArity : SCon -> Int
sconArity (SCon _ _ a _) = a

sconType : SCon -> String
sconType (SCon _ _ _ tn) = tn

-- A simplified pattern: wildcard, constructor or literal.
type SPat = SWild | SCtor SCon (List SPat) | SLit String

fromCtor : CtorInfo -> SCon
fromCtor ci = SCon (ctorName ci) (ctorShort ci) (ctorArity ci) (ctorTypeName ci)

tupleSCon : Int -> SCon
tupleSCon n = SCon ("tuple" ++ show n) "" n ("tuple" ++ show n)

-- All constructors of the type of a constructor.
siblings : Global -> SCon -> <IO> List SCon
siblings g (con@(SCon _ _ _ tn)) = match startsWith "tuple" tn with
  True -> [con]
  False -> match Map.lookup tn (readRef (gTypes g)) with
    Some ti -> map fromCtor (typeInfoCtors ti)
    None -> [con]

simplify : Global -> Pattern -> <IO> SPat
simplify g p = match p with
  PVar _ _ _ -> SWild
  PWild _ -> SWild
  PAs _ _ _ q -> simplify g q
  PAnnot _ q _ -> simplify g q
  PUnit _ -> SWild
  PLit _ l -> SLit (litKey l)
  PCon _ _ _ args conRef -> match readRef conRef with
    None -> SWild
    Some ci -> SCtor (fromCtor ci) (map (simplify g) args)
  PRec pos _ _ fields conRef -> match readRef conRef with
    None -> SWild
    Some ci -> SCtor (fromCtor ci) (map (simplify g) (recordPositional ci fields pos))
  PTuple _ elems -> SCtor (tupleSCon (length elems)) (map (simplify g) elems)
  PList _ elems ->
    let cons = fromCtor (builtinCtor g tListName 1)
    let nil = fromCtor (builtinCtor g tListName 0)
    foldr (\x acc -> SCtor cons [simplify g x, acc]) (SCtor nil []) elems

litKey : Lit -> String
litKey l = match l with
  LInt n -> "i" ++ show n
  LFloat f -> "f" ++ formatFloat f
  LString s -> "s" ++ s
  LChar ch -> "c" ++ charToString ch

checkMatches : Checker -> <IO> Unit
checkMatches c = forEach (reverse (readRef (cMatches c))) (checkSite c)

-- The analysis runs with the givens of the match and the types of its
-- columns, whose unknown types are made rigid: it must not bind them.
private checkSite : Checker -> MatchSite -> <IO> Unit
checkSite c (MatchSite p what rows guarded types givens) =
  let g = cG c
  let kept = filterMap id (map (\(r, gd) -> match gd with
    True -> None
    False -> Some (map (simplify g) r)) (zip rows guarded))
  let n = match rows with
    r :: _ -> length r
    [] -> 0
  let rigid = newRef Map.empty
  let tys = match length types == n with
    True -> map (\t -> Some (rigidCopy c rigid t)) types
    False -> replicate n None
  let saved = readRef (cGivens c)
  writeRef (cGivens c) givens
  let result = missing c kept tys n
  writeRef (cGivens c) saved
  match result with
    None -> ()
    Some w ->
      let parts = map (\x -> showSPat x (n > 1)) w
      errorf c p "non-exhaustive patterns in ${what}: the case `${joinWith " " parts}` is not handled"

-- A copy of a type with its unbound metas replaced by rigid variables.
private rigidCopy : Checker -> Ref (Map.Map Int Type) -> Type -> <IO> Type
rigidCopy c rigid t0 = match prune t0 with
  TMeta m -> match Map.lookup (metaId m) (readRef rigid) with
    Some t -> t
    None ->
      let t = newSkolem c "" (metaKind m)
      modifyRef rigid (Map.insert (metaId m) t)
      t
  TApp f a ->
    let f2 = rigidCopy c rigid f
    TApp f2 (rigidCopy c rigid a)
  TFun a e r ->
    let a2 = rigidCopy c rigid a
    let e2 = rigidCopy c rigid e
    TFun a2 e2 (rigidCopy c rigid r)
  TRowExt l r ->
    let l2 = rigidCopy c rigid l
    TRowExt l2 (rigidCopy c rigid r)
  t -> t

showSPat : SPat -> Bool -> String
showSPat p atom = match p with
  SWild -> "_"
  SLit _ -> "<literal>"
  SCtor (SCon _ short _ tn) args
    | startsWith "tuple" tn -> "(" ++ joinWith ", " (map (\a -> showSPat a False) args) ++ ")"
    | tn == tListName -> match args with
        [h, t] ->
          let s = showSPat h True ++ " :: " ++ showSPat t False
          match atom with
            True -> "(" ++ s ++ ")"
            False -> s
        _ -> "[]"
    | otherwise -> match args with
        [] -> short
        _ ->
          let s = joinWith " " (short :: map (\a -> showSPat a True) args)
          match atom with
            True -> "(" ++ s ++ ")"
            False -> s

wilds : Int -> List SPat
wilds n = replicate n SWild

-- Keep rows matching constructor con, expanding its arguments.
specialize : List (List SPat) -> SCon -> List (List SPat)
specialize rows con = filterMap (\r -> match r with
  SWild :: rest -> Some (wilds (sconArity con) ++ rest)
  SCtor c args :: rest | sconName c == sconName con -> Some (args ++ rest)
  _ -> None) rows

defaultRows : List (List SPat) -> List (List SPat)
defaultRows rows = filterMap (\r -> match r with
  SWild :: rest -> Some rest
  _ -> None) rows

-- A pattern vector not covered by rows, if any. tys holds the types of
-- the columns (when known).
missing : Checker -> List (List SPat) -> List (Option Type) -> Int -> <IO> Option (List SPat)
missing c rows tys n = match n == 0 with
  True -> match rows with
    [] -> Some []
    _ -> None
  False ->
    -- a constructor of the column's type, the constructors seen and
    -- whether a literal occurs
    let addSeen s con = match elem (sconName con) s with
      True -> s
      False -> snoc s (sconName con)
    let (ti, seen, hasLit) = foldl (\(t, s, l) r -> match r with
      SCtor con _ :: _ -> (Some con, addSeen s con, l)
      SLit _ :: _ -> (t, s, True)
      _ -> (t, s, l)) (None, [], False) rows
    let rest = drop 1 tys
    match ti with
      Some con0 ->
        let all = possibleCons c con0 (columnType tys)
        -- a constructor that refines types may rule out cases of the
        -- other columns: split on each of them even if some is not seen
        let split = allOf (\con -> elem (sconName con) seen) all || refining c con0
        match split with
          True -> firstMissing c rows tys n all
          False -> match missing c (defaultRows rows) rest (n - 1) with
            None -> None
            Some w -> match find (\con -> not (elem (sconName con) seen)) all with
              Some con -> Some (SCtor con (wilds (sconArity con)) :: w)
              None -> Some (SWild :: w)
      None -> match missing c (defaultRows rows) rest (n - 1) with
        None -> None
        Some w -> Some (SWild :: w)

private columnType : List (Option Type) -> Option Type
columnType tys = match tys with
  t :: _ -> t
  [] -> None

private firstMissing : Checker -> List (List SPat) -> List (Option Type) -> Int -> List SCon -> <IO> Option (List SPat)
firstMissing c rows tys n cons = match cons with
  [] -> None
  con :: rest ->
    let a = sconArity con
    let saved = readRef (cGivens c)
    let fields = conFieldTypes c con (columnType tys)
    let r = missing c (specialize rows con) (fields ++ drop 1 tys) (a + n - 1)
    writeRef (cGivens c) saved
    match r with
      Some w -> Some (SCtor con (take a w) :: drop a w)
      None -> firstMissing c rows tys n rest

private sconInfo : Global -> SCon -> <IO> Option CtorInfo
sconInfo g (SCon name _ _ tn) = match Map.lookup tn (readRef (gTypes g)) with
  Some ti -> find (\ci -> ctorName ci == name) (typeInfoCtors ti)
  None -> None

-- The constructors of the type of con0 that can build a value of type t:
-- matching a constructor that refines types may be impossible.
private possibleCons : Checker -> SCon -> Option Type -> <IO> List SCon
possibleCons c con0 t =
  let g = cG c
  let all = siblings g con0
  match t with
    Some ty | refining c con0 -> filter (\con -> match sconInfo g con with
      None -> True
      Some ci ->
        let saved = readRef (cGivens c)
        let ok = isSome (ctorFieldsAt c ci ty False)
        writeRef (cGivens c) saved
        ok) all
    _ -> all

-- Whether some constructor of the type of con may refine types.
private refining : Checker -> SCon -> <IO> Bool
refining c con = not (startsWith "tuple" (sconType con)) && typeRefines (cG c) (sconType con)

-- The types of the fields of con in a value of type t, assuming the
-- equations implied by matching it (pushed on the givens).
private conFieldTypes : Checker -> SCon -> Option Type -> <IO> List (Option Type)
conFieldTypes c con t =
  let g = cG c
  let unknown = replicate (sconArity con) None
  match t with
    None -> unknown
    Some ty -> match startsWith "tuple" (sconType con) with
      True ->
        let (_, args) = headOf (whnf c ty)
        match length args == sconArity con with
          True -> map Some args
          False -> unknown
      False -> match sconInfo g con with
        None -> unknown
        Some ci -> match typeRefines g (ctorTypeName ci) with
          True -> match ctorFieldsAt c ci ty False with
            Some fs -> map Some fs
            None -> unknown
          False ->
            let (_, args) = headOf (whnf c ty)
            match length args == length (paramsOf g ci) with
              True -> map (\f -> Some (substGen f args)) (ctorFields ci)
              False -> unknown

private paramsOf : Global -> CtorInfo -> <IO> List String
paramsOf g ci = match Map.lookup (ctorTypeName ci) (readRef (gTypes g)) with
  Some ti -> typeInfoParams ti
  None -> []
