-- Translating Core programs to Go source code.
module Ark.Codegen

import Ark.Util
import Ark.Ast
import Ark.Types
import Ark.Core
import Ark.Opt
import Std.Map as Map

-- ================================================================ globals

-- Every function takes the evidence (the handlers in scope and the
-- running task, see runtime/rt/effect.go) as its first argument `ev`,
-- except the foreign functions of kind GForeign.
type GKind = GFunc | GValue | GDict | GDictFn | GForeign | GForeignEv | GOp

instance Eq GKind where
  a == b = tagOf a == tagOf b

-- kind, arity, Go name (direct calls / value access), foreign target
type GInfo = GInfo GKind Int String String

-- program, globals, effect ids, temporary counter
type Gen = Gen Program (Map.Map String GInfo) (Map.Map String Int) (Ref Int)

-- A compiled Go expression: code, unboxed Go type ("" for rt.Value),
-- whether it can be duplicated or reordered safely.
type GVal = GVal String String Bool

boxed : String -> GVal
boxed code = GVal code "" False

valCode : GVal -> String
valCode (GVal c _ _) = c

valTyp : GVal -> String
valTyp (GVal _ t _) = t

valAtomic : GVal -> Bool
valAtomic (GVal _ _ a) = a

-- return, assign to a variable, discard
type Dest = DRet | DAssign String | DDiscard

-- the current function for self tail calls: global symbol, local name,
-- arity, whether a self tail call was emitted, unboxed parameter types
-- (kept in p0, p1, ...)
type SelfInfo = SelfInfo String String Int (Ref Bool) (List String)

-- The unboxed type of parameter i ("" when it is boxed).
paramType : List String -> Int -> String
paramType ts i = withDefault "" (nth i ts)

-- Bind the parameters of a function to locals. Unboxed parameters are
-- converted once, into p0, p1, ..., before the body (and its loop, for
-- self tail calls); returns those conversions.
bindParams : Ctx -> List String -> List String -> <IO> List String
bindParams c ps ts = filterMap id (mapList (\(i, p) ->
  let t = paramType ts i
  let conv = match t with
    "" ->
      line c "${local p} := a${i}"
      setVar c p ""
      None
    _ ->
      line c "${local p} := p${i}"
      setVar c p t
      Some "p${i} := a${i}.(${t})"
  line c "_ = ${local p}"
  conv) (indexed ps))

prologue : List String -> Int -> String
prologue pro ind = concatStrings (mapList (\l -> tabs ind ++ l ++ "\n") pro)

-- generator, body (reversed chunks), indentation, current function,
-- unboxed types of locals, local functions with a direct Go func (arity)
type Ctx = Ctx Gen (Ref (List String)) (Ref Int) (Option SelfInfo) (Ref (Map.Map String String)) (Ref (Map.Map String Int))

-- Options: generate a test runner instead of calling main.
generate : Program -> Bool -> <IO> Result String String
generate prog0 tests =
  let prog = optimize prog0
  let Program funcs values dicts foreigns ops effects _ _ _ = prog
  let effIDs = Map.fromList (mapList (\(i, Effect n _) -> (n, i)) (indexed effects))
  let g1 = foldl (\m (Func s ps _ _) -> Map.insert s (GInfo GFunc (length ps) ("f_" ++ mangle s) "") m) Map.empty funcs
  let g2 = foldl (\m (Value s _) -> Map.insert s (GInfo GValue 0 ("v_" ++ mangle s) "") m) g1 values
  let g3 = foldl (\m (Dict s ps _) -> match ps with
    [] -> Map.insert s (GInfo GDict 0 ("d_" ++ mangle s) "") m
    _ -> Map.insert s (GInfo GDictFn (length ps) ("mk_" ++ mangle s) "") m) g2 dicts
  let g4 = foldl (\m (Foreign s t a ev) -> match ev with
    True -> Map.insert s (GInfo GForeignEv a t t) m
    False -> Map.insert s (GInfo GForeign a t t) m) g3 foreigns
  let g5 = foldl (\m (Op s _ _ a) -> Map.insert s (GInfo GOp a ("op_" ++ mangle s) "") m) g4 ops
  let g = Gen prog g5 effIDs (newRef 0)
  let out = newRef []
  genProgram g out tests
  let src = concatStrings (reverse (readRef out))
  match formatGo src with
    Ok formatted -> Ok formatted
    Err e -> Err ("internal error: generated Go code does not parse: " ++ e)

-- Turn a symbol into a Go identifier fragment.
mangle : String -> String
mangle s = concatStrings (mapList mangleChar (chars s))

private mangleChar : Char -> String
mangleChar r
  | r == '.' = "_"
  | r == '$' = "ǂ"
  | r == '_' || charCode r < 128 && (isAlpha r || isDigit r) = charToString r
  | charCode r >= 128 && (isAlpha r || isDigit r) = charToString r
  | otherwise = "ǀ" ++ hex (charCode r)

hex : Int -> String
hex n = match n < 16 with
  True -> charToString (at n (chars "0123456789abcdef"))
  False -> hex (n / 16) ++ hex (n % 16)

local : String -> String
local name = "l_" ++ mangle name

-- The Go variable holding a global function as a value.
closureName : String -> String
closureName s = "c_" ++ mangle s

tabs : Int -> String
tabs n = strRepeat n "\t"

params : Int -> String -> String
params n prefix = match n with
  0 -> ""
  _ -> joinWith ", " (mapList (\i -> prefix ++ show i) (range 0 n)) ++ " rt.Value"

-- The parameters of a function of arity n: the evidence, then the
-- arguments.
evParams : Int -> String -> String
evParams n prefix = match n with
  0 -> "ev *rt.Ev"
  _ -> "ev *rt.Ev, " ++ params n prefix

-- The arguments of a call: the evidence, then the given codes.
evArgs : List String -> String
evArgs args = joinWith ", " ("ev" :: args)

argList : Int -> String -> String
argList n prefix = joinWith ", " (mapList (\i -> prefix ++ show i) (range 0 n))

-- Wrap a Go function of arity n (taking the evidence) as an Arkadia
-- function value.
closureOf : String -> Int -> String
closureOf fn n = match n <= 4 with
  True -> "rt.Fn${n}(${fn})"
  False -> "&rt.FnN{N: ${n}, F: func(ev *rt.Ev, a []rt.Value) rt.Value { return ${fn}(${evArgs (mapList (\i -> "a[${i}]") (range 0 n))}) }}"

-- Wrap a Go function of arity n that does not take the evidence.
plainClosureOf : String -> Int -> String
plainClosureOf fn n = match n <= 4 with
  True -> "rt.Fn${n}(func(${evParams n "a"}) rt.Value { return ${fn}(${argList n "a"}) })"
  False -> "&rt.FnN{N: ${n}, F: func(ev *rt.Ev, a []rt.Value) rt.Value { return ${fn}(${joinWith ", " (mapList (\i -> "a[${i}]") (range 0 n))}) }}"

emitOut : Ref (List String) -> String -> <IO> Unit
emitOut out s = modifyRef out (\xs -> s :: xs)

gInfo : Gen -> String -> Option GInfo
gInfo (Gen _ globals _ _) s = Map.lookup s globals

effID : Gen -> String -> Int
effID (Gen _ _ ids _) e = Map.findWithDefault 0 e ids

genProgram : Gen -> Ref (List String) -> Bool -> <IO> Unit
genProgram g out tests =
  let Gen prog globals effIDs _ = g
  let Program funcs values dicts _ ops effects main testList failEff = prog
  let pr s = emitOut out s
  pr "// Code generated by the Arkadia compiler. DO NOT EDIT.\n\npackage main\n\n"
  pr "import rt \"arkprog/rt\"\n\n"
  pr "var _ = rt.Unit\n\n"
  -- effect operations
  forEach ops (\(Op s eff idx a) ->
    let GInfo _ _ name _ = withDefault (GInfo GOp a "" "") (gInfo g s)
    pr "func ${name}(${evParams a "a"}) rt.Value { return rt.Perform(ev, ${effID g eff}, ${idx}, []rt.Value{${argList a "a"}}) }\n\n")
  -- functions
  forEach funcs (genFunction g out)
  -- dictionary constructors
  forEach dicts (\(Dict s ps slots) -> match gInfo g s with
    Some (GInfo GDict _ name _) -> pr "var ${name} = rt.NewDict(${length slots})\n\n"
    Some (GInfo _ _ name _) ->
      let c = newCtx g
      forEach (indexed ps) (\(i, p) ->
        line c "${local p} := a${i}"
        line c "_ = ${local p}")
      line c "${local "self"} := rt.NewDict(${length slots})"
      forEach (indexed slots) (\(i, sl) ->
        let v = genExpr c sl
        line c "${local "self"}.S[${i}] = ${valCode v}")
      line c "return ${local "self"}"
      pr "func ${name}(${evParams (length ps) "a"}) rt.Value {\n${ctxBody c}}\n\n"
    None -> ())
  -- closure values and constants
  let entries = Map.toList globals
  let valueSyms = filterMap (\(s, GInfo k _ _ _) -> match k == GValue with
    True -> Some s
    False -> None) entries
  forEach valueSyms (\s -> match gInfo g s with
    Some (GInfo _ _ name _) -> pr "var ${name} rt.Value\n"
    None -> ())
  let syms = filterMap (\(s, GInfo k a _ _) -> match k with
    GFunc -> Some s
    GDictFn -> Some s
    GOp -> Some s
    GForeign | a > 0 -> Some s
    GForeignEv | a > 0 -> Some s
    _ -> None) entries
  forEach syms (\s -> pr "var ${closureName s} rt.Value\n")
  pr "\nfunc init() {\n\tev := rt.InitEv\n\t_ = ev\n"
  forEach syms (\s -> match gInfo g s with
    Some (GInfo GForeign a name _) -> pr "\t${closureName s} = ${plainClosureOf name a}\n"
    Some (GInfo _ a name _) -> pr "\t${closureName s} = ${closureOf name a}\n"
    None -> ())
  -- effect names for diagnostics
  pr "\trt.EffectNames = []string{"
  forEach effects (\(Effect n _) -> pr "${show (shortName n)}, ")
  pr "}\n\trt.OpNames = [][]string{"
  forEach effects (\(Effect _ opNames) ->
    pr "{"
    forEach opNames (\o -> pr "${show o}, ")
    pr "}, ")
  pr "}\n"
  -- dictionaries and values in dependency order
  forEach (initOrder prog) (\item -> match item with
    Left (Dict s _ slots) ->
      let GInfo _ _ name _ = withDefault (GInfo GDict 0 "" "") (gInfo g s)
      let c = newCtx g
      line c "${local "self"} := ${name}"
      forEach (indexed slots) (\(i, sl) ->
        let v = genExpr c sl
        line c "${local "self"}.S[${i}] = ${valCode v}")
      pr "\t{\n${ctxBody c}\t}\n"
    Right (Value s body) ->
      let GInfo _ _ name _ = withDefault (GInfo GValue 0 "" "") (gInfo g s)
      let c = newCtx g
      genStmt c body DRet
      pr "\t${name} = func() rt.Value {\n${ctxBody c}\t}()\n")
  pr "}\n\n"
  match tests with
    True ->
      let failID = match Map.lookup failEff effIDs with
        Some i -> i
        None -> -1
      pr "func main() {\n\trt.Main(func(_ *rt.Ev) {\n\t\trt.RunTests(${failID}, []rt.TestCase{\n"
      forEach testList (\(Test tname s) ->
        let GInfo _ _ name _ = withDefault (GInfo GFunc 0 "" "") (gInfo g s)
        pr "\t\t\t{Module: ${show (qualifierOf s)}, Name: ${show tname}, Run: func(ev *rt.Ev) { ${name}(ev, rt.Unit) }},\n")
      pr "\t\t})\n\t})\n}\n"
    False -> match main with
      "" -> ()
      _ ->
        let call = match gInfo g main with
          Some (GInfo GFunc _ name _) -> "${name}(ev, rt.Unit)"
          Some (GInfo _ _ name _) -> "rt.Apply1(ev, ${name}, rt.Unit)"
          None -> "rt.Apply1(ev, nil, rt.Unit)"
        pr "func main() {\n\trt.Main(func(ev *rt.Ev) { ${call} })\n}\n"

-- An item to initialize: a dictionary or a value.
type Either a b = Left a | Right b

-- Sort dictionaries and values so that each is initialized after the
-- values and dictionaries it (transitively) uses.
initOrder : Program -> <IO> List (Either Dict Value)
initOrder (Program funcs values dicts _ _ _ _ _ _) =
  let funcRefs = Map.fromList (mapList (\(Func s _ b _) -> (s, refsOf [b])) funcs)
  let plainDicts = filter (\(Dict _ ps _) -> isEmpty ps) dicts
  let items = Map.fromList (mapList (\d -> (dictSym d, Left d)) plainDicts ++ mapList (\(v@(Value s _)) -> (s, Right v)) values)
  let order = mapList dictSym plainDicts ++ mapList (\(Value s _) -> s) values
  let dictFnRefs = Map.fromList (filterMap (\(Dict s ps slots) -> match ps with
    [] -> None
    _ -> Some (s, refsOf slots)) dicts)
  -- items reachable through functions, in discovery order
  let reachOf sym =
    let seen = newRef (Map.singleton sym True)
    let acc = newRef []
    let deps s = match Map.member s (readRef seen) with
      True -> ()
      False ->
        modifyRef seen (Map.insert s True)
        match Map.lookup s funcRefs with
          Some refs -> forEach refs deps
          None -> match Map.lookup s dictFnRefs with
            Some refs -> forEach refs deps
            None -> match Map.member s items with
              True -> modifyRef acc (\a -> s :: a)
              False -> ()
    let direct = match Map.lookup sym items with
      Some (Left (Dict _ _ slots)) -> refsOf slots
      Some (Right (Value _ b)) -> refsOf [b]
      None -> []
    forEach direct deps
    reverse (readRef acc)
  let reach = Map.fromList (mapList (\s -> (s, reachOf s)) order)
  let state = newRef Map.empty
  let out = newRef []
  let visit s = match Map.member s (readRef state) with
    True -> ()
    False ->
      modifyRef state (Map.insert s 1)
      forEach (Map.findWithDefault [] s reach) visit
      modifyRef state (Map.insert s 2)
      match Map.lookup s items with
        Some it -> modifyRef out (\o -> it :: o)
        None -> ()
  forEach order visit
  reverse (readRef out)

-- Global symbols referenced by expressions (pre-order).
refsOf : List CExpr -> List String
refsOf es = reverse (foldl (\acc e -> collectNodes (\x -> match x with
  CGlobal s -> Some s
  _ -> None) e acc) [] es)

-- ================================================================ functions

genFunction : Gen -> Ref (List String) -> Func -> <IO> Unit
genFunction g out (Func s ps body ts) =
  let name = match gInfo g s with
    Some (GInfo _ _ n _) -> n
    None -> "f_" ++ mangle s
  let used = newRef False
  let c0 = newCtx g
  let c = withSelf c0 (Some (SelfInfo s "" (length ps) used ts))
  writeRef (ctxIndent c) 2
  let pro = prologue (bindParams c ps ts) 1
  genStmt c body DRet
  match readRef used with
    True -> emitOut out "func ${name}(${evParams (length ps) "a"}) rt.Value {\n${pro}\tfor {\n${ctxBody c}\t}\n}\n\n"
    False -> emitOut out "func ${name}(${evParams (length ps) "a"}) rt.Value {\n${pro}${dedent (ctxBody c)}}\n\n"

dedent : String -> String
dedent s = joinWith "\n" (mapList (\l -> match startsWith "\t" l with
  True -> substring 1 (stringLength l) l
  False -> l) (split "\n" s))

-- ================================================================ contexts

newCtx : Gen -> <IO> Ctx
newCtx g = Ctx g (newRef []) (newRef 1) None (newRef Map.empty) (newRef Map.empty)

ctxGen : Ctx -> Gen
ctxGen (Ctx g _ _ _ _ _) = g

ctxBodyRef : Ctx -> Ref (List String)
ctxBodyRef (Ctx _ b _ _ _ _) = b

ctxIndent : Ctx -> Ref Int
ctxIndent (Ctx _ _ i _ _ _) = i

ctxSelf : Ctx -> Option SelfInfo
ctxSelf (Ctx _ _ _ s _ _) = s

ctxVars : Ctx -> Ref (Map.Map String String)
ctxVars (Ctx _ _ _ _ v _) = v

ctxLfuns : Ctx -> Ref (Map.Map String Int)
ctxLfuns (Ctx _ _ _ _ _ l) = l

withSelf : Ctx -> Option SelfInfo -> Ctx
withSelf (Ctx g b i _ v l) s = Ctx g b i s v l

ctxBody : Ctx -> <IO> String
ctxBody c = concatStrings (reverse (readRef (ctxBodyRef c)))

indentOf : Ctx -> <IO> Int
indentOf c = readRef (ctxIndent c)

-- A context for a nested Go function literal.
sub : Ctx -> <IO> Ctx
sub c = Ctx (ctxGen c) (newRef []) (newRef 1) None (newRef (readRef (ctxVars c))) (newRef (readRef (ctxLfuns c)))

write : Ctx -> String -> <IO> Unit
write c s = modifyRef (ctxBodyRef c) (\xs -> s :: xs)

line : Ctx -> String -> <IO> Unit
line c s = write c (tabs (indentOf c) ++ s ++ "\n")

open : Ctx -> String -> <IO> Unit
open c s =
  line c s
  modifyRef (ctxIndent c) (\i -> i + 1)

close : Ctx -> String -> <IO> Unit
close c s =
  modifyRef (ctxIndent c) (\i -> i - 1)
  line c s

setVar : Ctx -> String -> String -> <IO> Unit
setVar c name typ = modifyRef (ctxVars c) (Map.insert name typ)

varType : Ctx -> String -> <IO> String
varType c name = Map.findWithDefault "" name (readRef (ctxVars c))

newTmp : Ctx -> <IO> String
newTmp c =
  let Gen _ _ _ tmp = ctxGen c
  "t" ++ show (nextId tmp)

-- Convert a compiled expression to the requested unboxed type.
as : GVal -> String -> String
as (GVal code t _) typ
  | t == typ = code
  | t == "" = code ++ ".(" ++ typ ++ ")"
  | typ == "" = code
  | otherwise = error "codegen: cannot convert ${t} to ${typ}"

-- Ensure that v can be duplicated or reordered safely.
atom : Ctx -> GVal -> <IO> GVal
atom c v = match valAtomic v with
  True -> v
  False ->
    let t = newTmp c
    match valTyp v with
      "" -> line c "var ${t} rt.Value = ${valCode v}"
      _ -> line c "${t} := ${valCode v}"
    GVal t (valTyp v) True

emit : Ctx -> Dest -> GVal -> <IO> Unit
emit c d v = match d with
  DRet -> line c "return ${valCode v}"
  DAssign x -> line c "${x} = ${valCode v}"
  DDiscard -> match valAtomic v with
    True -> ()
    False -> line c "_ = ${valCode v}"

-- ================================================================ statements

genStmt : Ctx -> CExpr -> Dest -> <IO> Unit
genStmt c e d = match e with
  CLet name v body ->
    genLet c name v
    genStmt c body d
  CLetRec names lams body ->
    genLetRec c names lams
    genStmt c body d
  CIf cond t f ->
    let cv = genExpr c cond
    open c "if ${as cv "bool"} {"
    genStmt c t d
    modifyRef (ctxIndent c) (\i -> i - 1)
    open c "} else {"
    genStmt c f d
    close c "}"
  CMatch scruts rows wh -> genMatch c scruts rows wh d
  CApp _ _ -> match d with
    DRet | tailCall c e -> ()
    _ -> emit c d (genExpr c e)
  _ -> emit c d (genExpr c e)

genLet : Ctx -> String -> CExpr -> <IO> Unit
genLet c name v = match (name, v) with
  ("_", _) -> genStmt c v DDiscard
  (_, CLam (lam@(Lam ps _ _))) | length ps <= 4 -> localFunc c name lam
  _ ->
    let x = genExpr c v
    match valTyp x with
      "" -> line c "var ${local name} rt.Value = ${valCode x}"
      _ -> line c "${local name} := ${valCode x}"
    line c "_ = ${local name}"
    setVar c name (valTyp x)

-- Declare a local function with a direct Go func value.
localFunc : Ctx -> String -> Lam -> <IO> Unit
localFunc c name lam =
  let n = length (lamParams lam)
  let fn = "lf_" ++ mangle name
  line c "var ${fn} func(${evParams n "a"}) rt.Value"
  line c "var ${local name} rt.Value"
  modifyRef (ctxLfuns c) (Map.insert name n)
  setVar c name ""
  let body = lambdaBody c lam name
  line c "${fn} = func(${evParams n "a"}) rt.Value {"
  write c body
  line c "}"
  line c "${local name} = ${closureOf fn n}"
  line c "_ = ${local name}"

genLetRec : Ctx -> List String -> List Lam -> <IO> Unit
genLetRec c names lams =
  -- declare everything first so that bodies can refer to each other
  forEach (zip names lams) (\(name, Lam ps _ _) ->
    let n = length ps
    match n <= 4 with
      True ->
        line c "var ${"lf_" ++ mangle name} func(${evParams n "a"}) rt.Value"
        modifyRef (ctxLfuns c) (Map.insert name n)
      False -> ()
    line c "var ${local name} rt.Value"
    setVar c name "")
  forEach (zip names lams) (\(name, lam@(Lam ps _ _)) ->
    let n = length ps
    match n <= 4 with
      True ->
        let fn = "lf_" ++ mangle name
        let body = lambdaBody c lam name
        line c "${fn} = func(${evParams n "a"}) rt.Value {"
        write c body
        line c "}"
        line c "${local name} = ${closureOf fn n}"
      False ->
        let v = genLambda c lam
        line c "${local name} = ${valCode v}"
    line c "_ = ${local name}")

-- The body of a function literal with parameters a0...
lambdaBody : Ctx -> Lam -> String -> <IO> String
lambdaBody c (Lam ps body ts) selfName =
  let s0 = sub c
  let ind = indentOf c
  let selfInfo = match selfName with
    "" -> None
    _ -> Some (SelfInfo "" selfName (length ps) (newRef False) ts)
  let s = withSelf s0 selfInfo
  writeRef (ctxIndent s) (match selfInfo with
    Some _ -> ind + 2
    None -> ind + 1)
  let pro = prologue (bindParams s ps ts) (ind + 1)
  genStmt s body DRet
  let text = ctxBody s
  match selfInfo with
    None -> pro ++ text
    Some (SelfInfo _ _ _ used _) -> match readRef used with
      True ->
        let tind = tabs (ind + 1)
        pro ++ tind ++ "for {\n" ++ text ++ tind ++ "}\n"
      False -> pro ++ dedent text

genLambda : Ctx -> Lam -> <IO> GVal
genLambda c (lam@(Lam ps body _)) =
  let n = length ps
  match n <= 4 with
    True ->
      let text = lambdaBody c lam ""
      boxed "rt.Fn${n}(func(${evParams n "a"}) rt.Value {\n${text}${tabs (indentOf c)}})"
    False ->
      let s = sub c
      writeRef (ctxIndent s) (indentOf c + 1)
      forEach (indexed ps) (\(i, p) ->
        line s "${local p} := a[${i}]"
        line s "_ = ${local p}"
        setVar s p "")
      genStmt s body DRet
      boxed "&rt.FnN{N: ${n}, F: func(ev *rt.Ev, a []rt.Value) rt.Value {\n${ctxBody s}${tabs (indentOf c)}}}"

-- Turn a saturated self call in tail position into a loop jump.
tailCall : Ctx -> CExpr -> <IO> Bool
tailCall c e = match (ctxSelf c, e) with
  (Some (SelfInfo global localName arity used ts), CApp f args) | length args == arity ->
    let isSelf = match f with
      CGlobal s -> s == global && global != ""
      CVar v -> v == localName && localName != ""
      _ -> False
    match isSelf with
      False -> False
      True ->
        let vals = mapList (\a -> atom c (genExpr c a)) args
        forEach (indexed vals) (\(i, v) -> match paramType ts i with
          "" -> line c "a${i} = ${valCode v}"
          t -> line c "p${i} = ${as v t}")
        line c "continue"
        writeRef used True
        True
  _ -> False

-- ================================================================ expressions

genExprs : Ctx -> List CExpr -> <IO> List GVal
genExprs c es = mapList (\e -> atom c (genExpr c e)) es

codes : List GVal -> String
codes vs = joinWith ", " (mapList valCode vs)

genExpr : Ctx -> CExpr -> <IO> GVal
genExpr c e = match e with
  CVar n -> GVal (local n) (varType c n) True
  CLit v -> literal v
  CGlobal s -> genGlobal c s
  CApp _ _ -> genApp c e
  CLam lam -> genLambda c lam
  CCon ci args -> genCon c ci args
  CSelect d slot ->
    let known = match d with
      CGlobal s -> match gInfo (ctxGen c) s with
        Some (GInfo GDict _ name _) -> Some name
        _ -> None
      _ -> None
    match known with
      Some name -> boxed "${name}.S[${slot}]"
      None ->
        let dv = atom c (genExpr c d)
        boxed "rt.Sel(${valCode dv}, ${slot})"
  CConcat parts ->
    let ps = genExprs c parts
    GVal ("(" ++ joinWith " + " (mapList (\p -> as p "string") ps) ++ ")") "string" False
  CLet name v body ->
    genLet c name v
    genExpr c body
  CLetRec names lams body ->
    genLetRec c names lams
    genExpr c body
  CHandle h -> genHandle c h
  CMask effs body ->
    let ids = mapList (\eff -> show (effID (ctxGen c) eff)) effs
    let s = sub c
    writeRef (ctxIndent s) (indentOf c + 1)
    genStmt s body DRet
    boxed "rt.Mask(ev, []int{${joinWith ", " ids}}, func(ev *rt.Ev) rt.Value {\n${ctxBody s}${tabs (indentOf c)}})"
  _ ->
    let t = newTmp c
    line c "var ${t} rt.Value"
    genStmt c e (DAssign t)
    -- the value may be discarded
    line c "_ = ${t}"
    GVal t "" True

literal : Val -> GVal
literal v = match v with
  VInt n -> GVal "int64(${n})" "int64" True
  VFloat f -> GVal "float64(${formatFloat f})" "float64" True
  VString s -> GVal (show s) "string" True
  VChar ch -> GVal "rune(${charCode ch})" "rune" True
  VBool b -> GVal (showBool b) "bool" True
  VUnit -> GVal "rt.Unit" "" True

genGlobal : Ctx -> String -> <IO> GVal
genGlobal c s = match gInfo (ctxGen c) s with
  None -> error ("codegen: unknown global " ++ s)
  Some (GInfo k a name target) -> match k with
    GValue -> GVal name "" True
    GDict -> GVal name "" True
    GForeign | a == 0 -> boxed (target ++ "()")
    GForeignEv | a == 0 -> boxed (target ++ "(ev)")
    _ -> GVal (closureName s) "" True

genApp : Ctx -> CExpr -> <IO> GVal
genApp c e = match e with
  CApp (CHandle (h@(Handle _ _ _ _ _ _ _ (Some _) _))) args ->
    let init = atom c (genExpr c (at 0 args))
    let res = handleState c h init
    match drop 1 args with
      [] -> res
      more ->
        let r = atom c res
        applyValue r (genExprs c more)
  CApp (CGlobal s) args | knownCallable (gInfo (ctxGen c) s) ->
    let vals = genExprs c args
    match gInfo (ctxGen c) s with
      Some info -> callKnown c info vals
      None -> error "genApp"
  CApp f args ->
    let lfun = match f with
      CVar v -> match Map.lookup v (readRef (ctxLfuns c)) with
        Some n -> Some (v, n)
        None -> None
      _ -> None
    match lfun with
      Some (v, n) ->
        let vals = genExprs c args
        let fn = "lf_" ++ mangle v
        match compare (length vals) n with
          EQ -> boxed "${fn}(${evArgs (mapList valCode vals)})"
          GT ->
            let head = boxed "${fn}(${evArgs (mapList valCode (take n vals))})"
            let hv = atom c head
            applyValue hv (drop n vals)
          LT ->
            -- partial application: apply the closure (the arguments are
            -- already evaluated)
            let fv = atom c (genExpr c f)
            applyValue fv vals
      None ->
        let fv = atom c (genExpr c f)
        let vals = genExprs c args
        applyValue fv vals
  _ -> error "genApp: not an application"

private knownCallable : Option GInfo -> Bool
knownCallable info = match info with
  Some (GInfo k a _ _) -> k != GValue && k != GDict && a > 0
  None -> False

applyValue : GVal -> List GVal -> GVal
applyValue f args = match length args <= 4 with
  True -> boxed "rt.Apply${length args}(ev, ${valCode f}, ${codes args})"
  False -> boxed "rt.ApplyN(ev, ${valCode f}, ${codes args})"

callKnown : Ctx -> GInfo -> List GVal -> <IO> GVal
callKnown c (info@(GInfo _ n _ _)) args = match compare (length args) n with
  LT ->
    -- partial application: capture the given arguments
    let rest = n - length args
    let all = mapList valCode args ++ mapList (\i -> "b${i}") (range 0 rest)
    let call = directCall info all args
    match rest <= 4 with
      True -> boxed "rt.Fn${rest}(func(${evParams rest "b"}) rt.Value { return ${valCode call} })"
      False ->
        let idx = mapList (\i -> "b${i} := a[${i}]") (range 0 rest)
        boxed "&rt.FnN{N: ${rest}, F: func(ev *rt.Ev, a []rt.Value) rt.Value { ${joinWith "; " idx}; return ${valCode call} }}"
  _ ->
    let first = take n args
    let res = directCall info (mapList valCode first) first
    match drop n args with
      [] -> res
      more ->
        let r = atom c (GVal (valCode res) (valTyp res) False)
        applyValue r more

-- A saturated call; foreign primitives may be inlined.
directCall : GInfo -> List String -> List GVal -> GVal
directCall (GInfo k _ name target) argCodes args =
  let prim = match k == GForeign && length args == length argCodes && not (allConstant args) with
    True -> primOf target
    False -> None
  match prim with
    Some (pin, pout, render) -> GVal (render (mapList (\a -> as a pin) args)) pout False
    None -> match k == GForeign with
      True -> boxed "${name}(${joinWith ", " argCodes})"
      False -> boxed "${name}(${evArgs argCodes})"

-- Whether all arguments are literals; inlining them would make Go fold
-- (and possibly reject, on overflow) the expression.
allConstant : List GVal -> Bool
allConstant args = allOf (\a ->
  let code = valCode a
  startsWith "int64(" code || startsWith "float64(" code || startsWith "rune(" code || startsWith "\"" code) args

private bin : String -> List String -> String
bin op xs = match xs with
  [a, b] -> "(${a} ${op} ${b})"
  _ -> error "primitive arity"

private un : String -> List String -> String
un op xs = match xs with
  [a] -> "(${op}${a})"
  _ -> error "primitive arity"

private call : String -> List String -> String
call f xs = "${f}(${joinWith ", " xs})"

private conv : String -> List String -> String
conv t xs = match xs with
  [a] -> "${t}(${a})"
  _ -> error "primitive arity"

-- Foreign functions compiled inline with unboxed arithmetic: argument
-- type, result type and rendering.
primOf : String -> Option (String, String, List String -> String)
primOf target = match target with
  "rt.IntAdd" -> Some ("int64", "int64", bin "+")
  "rt.IntSub" -> Some ("int64", "int64", bin "-")
  "rt.IntMul" -> Some ("int64", "int64", bin "*")
  "rt.IntNeg" -> Some ("int64", "int64", un "-")
  "rt.IntDiv" -> Some ("int64", "int64", call "rt.IDiv")
  "rt.IntRem" -> Some ("int64", "int64", call "rt.IRem")
  "rt.IntMod" -> Some ("int64", "int64", call "rt.IMod")
  "rt.IntEq" -> Some ("int64", "bool", bin "==")
  "rt.IntLt" -> Some ("int64", "bool", bin "<")
  "rt.IntLe" -> Some ("int64", "bool", bin "<=")
  "rt.IntGt" -> Some ("int64", "bool", bin ">")
  "rt.IntGe" -> Some ("int64", "bool", bin ">=")
  "rt.IntToFloat" -> Some ("int64", "float64", conv "float64")
  "rt.FloatAdd" -> Some ("float64", "float64", bin "+")
  "rt.FloatSub" -> Some ("float64", "float64", bin "-")
  "rt.FloatMul" -> Some ("float64", "float64", bin "*")
  "rt.FloatDiv" -> Some ("float64", "float64", bin "/")
  "rt.FloatNeg" -> Some ("float64", "float64", un "-")
  "rt.FloatEq" -> Some ("float64", "bool", bin "==")
  "rt.FloatLt" -> Some ("float64", "bool", bin "<")
  "rt.FloatLe" -> Some ("float64", "bool", bin "<=")
  "rt.FloatGt" -> Some ("float64", "bool", bin ">")
  "rt.FloatGe" -> Some ("float64", "bool", bin ">=")
  "rt.StringEq" -> Some ("string", "bool", bin "==")
  "rt.StringConcat" -> Some ("string", "string", bin "+")
  "rt.CharEq" -> Some ("rune", "bool", bin "==")
  "rt.CharCode" -> Some ("rune", "int64", conv "int64")
  _ -> None

genCon : Ctx -> CtorInfo -> List CExpr -> <IO> GVal
genCon c ci args
  | ctorTypeName ci == tBoolName = GVal (showBool (ctorTag ci == 1)) "bool" True
  | ctorTypeName ci == tUnitName = GVal "rt.Unit" "" True
  | ctorArity ci == 0 = match ctorTypeName ci == tListName with
      True -> GVal "rt.Nil" "" True
      False -> GVal "rt.Con0(${ctorTag ci})" "" False
  | otherwise =
      let vs = genExprs c args
      let tag = ctorTag ci
      match vs with
        [a] -> boxed "&rt.D1{T: ${tag}, A: ${valCode a}}"
        [a, b] -> boxed "&rt.D2{T: ${tag}, A: ${valCode a}, B: ${valCode b}}"
        [a, b, d] -> boxed "&rt.D3{T: ${tag}, A: ${valCode a}, B: ${valCode b}, C: ${valCode d}}"
        _ -> boxed "&rt.DN{T: ${tag}, F: []rt.Value{${codes vs}}}"

-- ================================================================ handlers

-- A state-passing handler applied to its initial state.
handleState : Ctx -> Handle -> GVal -> <IO> GVal
handleState c (Handle eff body _ _ _ _ _ sret sops) init =
  let ind = tabs (indentOf c)
  let retS = match sret with
    Some l -> fnBody c l "a"
    None -> ""
  let opsText = concatStrings (mapList (\(Lam ps ob _) ->
    let s = sub c
    writeRef (ctxIndent s) (indentOf c + 2)
    let n = length ps
    forEach (indexed (take (n - 1) ps)) (\(i, p) ->
      line s "${local p} := args[${i}]"
      line s "_ = ${local p}"
      setVar s p "")
    let st = lastOf ps
    line s "${local st} := st"
    line s "_ = ${local st}"
    setVar s st ""
    genStmt s ob DRet
    "${ind}\tfunc(ev *rt.Ev, args []rt.Value, st rt.Value) rt.Value {\n${ctxBody s}${ind}\t},\n") sops)
  let s = sub c
  writeRef (ctxIndent s) (indentOf c + 1)
  genStmt s body DRet
  boxed "rt.HandleState(ev, &rt.Handler{Eff: ${effID (ctxGen c) eff}, State: true, RetS: func(ev *rt.Ev, a0, a1 rt.Value) rt.Value {\n${retS}${ind}}, OpsS: []func(*rt.Ev, []rt.Value, rt.Value) rt.Value{\n${opsText}${ind}}}, ${valCode init}, func(ev *rt.Ev) rt.Value {\n${ctxBody s}${ind}})"

-- The body of a lambda whose parameters are named prefix0, prefix1, ...
fnBody : Ctx -> Lam -> String -> <IO> String
fnBody c (Lam ps body _) prefix =
  let s = sub c
  writeRef (ctxIndent s) (indentOf c + 1)
  forEach (indexed ps) (\(i, p) ->
    line s "${local p} := ${prefix}${i}"
    line s "_ = ${local p}"
    setVar s p "")
  genStmt s body DRet
  ctxBody s

genHandle : Ctx -> Handle -> <IO> GVal
genHandle c (Handle eff body ret ops usesK tail direct _ _) =
  let ind = tabs (indentOf c)
  let retText = match ret with
    Some l -> "Ret: func(ev *rt.Ev, a0 rt.Value) rt.Value {\n${lambdaBody c l ""}${ind}}, "
    None -> ""
  let opsText = concatStrings (mapList (\(Lam ps ob _) ->
    let s = sub c
    writeRef (ctxIndent s) (indentOf c + 2)
    let n = length ps
    forEach (indexed (take (n - 1) ps)) (\(i, p) ->
      line s "${local p} := args[${i}]"
      line s "_ = ${local p}"
      setVar s p "")
    let k = lastOf ps
    line s "${local k} := k"
    line s "_ = ${local k}"
    setVar s k ""
    genStmt s ob DRet
    "${ind}\tfunc(ev *rt.Ev, args []rt.Value, k rt.Value) rt.Value {\n${ctxBody s}${ind}\t},\n") ops)
  let uses = concatStrings (mapList (\u -> showBool u ++ ", ") usesK)
  let s = sub c
  writeRef (ctxIndent s) (indentOf c + 1)
  genStmt s body DRet
  boxed "rt.Handle(ev, &rt.Handler{Eff: ${effID (ctxGen c) eff}, ${retText}Ops: []func(*rt.Ev, []rt.Value, rt.Value) rt.Value{\n${opsText}${ind}}, UsesK: []bool{${uses}}, Tail: ${showBool tail}, Direct: ${showBool direct}}, func(ev *rt.Ev) rt.Value {\n${ctxBody s}${ind}})"

-- ================================================================ pattern matching

-- Whether a pattern always matches a value of its type.
irrefutableC : CPat -> Bool
irrefutableC p = match p with
  CPWild -> True
  CPVar _ -> True
  CPAs _ q -> irrefutableC q
  CPCon ci args
    | ctorTypeName ci == tBoolName -> False
    | ctorSiblings ci != 1 -> False
    | otherwise -> allOf irrefutableC args
  _ -> False

genMatch : Ctx -> List CExpr -> List Row -> String -> Dest -> <IO> Unit
genMatch c scrutEs rows wh d =
  let scruts = mapList (\s ->
    let v = genExpr c s
    match valAtomic v with
      True -> v
      False ->
        let a = atom c v
        line c "_ = ${valCode a}"
        a) scrutEs
  -- a single irrefutable row needs no tests
  match rows with
    [Row pats (Some body) _] | allOf irrefutableC pats ->
      forEach (zip pats scruts) (\(p, s) ->
        let _ = genPattern c p s
        ())
      genStmt c body d
    _ ->
      let label = "M" ++ newTmp c
      let saved = readRef (ctxBodyRef c)
      writeRef (ctxBodyRef c) []
      modifyRef (ctxIndent c) (\i -> i + 1)
      let usedBreak = newRef False
      forEach rows (\r -> genRow c r scruts d label usedBreak)
      line c "panic(rt.MatchFail(${show wh}))"
      modifyRef (ctxIndent c) (\i -> i - 1)
      let rowsText = ctxBody c
      writeRef (ctxBodyRef c) saved
      match readRef usedBreak with
        True -> line c "${label}:"
        False -> ()
      line c "switch {"
      line c "default:"
      write c rowsText
      line c "}"

genRow : Ctx -> Row -> List GVal -> Dest -> String -> Ref Bool -> <IO> Unit
genRow c (Row pats body guards) scruts d label usedBreak =
  open c "{"
  let depth = sum (mapList (\(p, s) -> genPattern c p s) (zip pats scruts))
  let finish () = match d with
    DRet -> ()
    _ ->
      line c "break ${label}"
      writeRef usedBreak True
  match body with
    Some b ->
      genStmt c b d
      finish ()
    None -> forEach guards (\(cond, gb) ->
      let cv = genExpr c cond
      open c "if ${as cv "bool"} {"
      genStmt c gb d
      finish ()
      close c "}")
  forEach (range 0 depth) (\_ -> close c "}")
  close c "}"

fieldAccess : String -> Int -> Int -> String
fieldAccess f arity i = match arity <= 3 with
  True -> f ++ "." ++ charToString (fromCharCode (65 + i))
  False -> "${f}.F[${i}]"

structName : Int -> String
structName arity = match arity <= 3 with
  True -> "*rt.D${arity}"
  False -> "*rt.DN"

-- Emit tests and bindings for p against s; returns the number of opened
-- blocks.
genPattern : Ctx -> CPat -> GVal -> <IO> Int
genPattern c p s = match p with
  CPWild -> 0
  CPVar name ->
    line c "${local name} := ${valCode s}"
    line c "_ = ${local name}"
    setVar c name (valTyp s)
    0
  CPAs name inner ->
    line c "${local name} := ${valCode s}"
    line c "_ = ${local name}"
    setVar c name (valTyp s)
    genPattern c inner s
  CPLit v ->
    let l = literal v
    open c "if ${as s (valTyp l)} == ${valCode l} {"
    1
  CPCon ci args
    | ctorTypeName ci == tBoolName ->
        match ctorTag ci == 1 with
          True -> open c "if ${as s "bool"} {"
          False -> open c "if !${as s "bool"} {"
        1
    | ctorTypeName ci == tUnitName -> 0
    | otherwise ->
        let n0 = match ctorSiblings ci > 1 with
          True ->
            open c "if rt.TagOf(${valCode s}) == ${ctorTag ci} {"
            1
          False -> 0
        let needFields = anyOf (\a -> match a with
          CPWild -> False
          _ -> True) args
        match needFields with
          False -> n0
          True ->
            let f = newTmp c
            let arity = ctorArity ci
            line c "${f} := ${valCode s}.(${structName arity})"
            n0 + sum (mapList (\(i, a) -> genPattern c a (GVal (fieldAccess f arity i) "" True)) (indexed args))
