-- An expression evaluator: a parser built on algebraic effects (Std.Parser),
-- pattern matching on the syntax tree, and evaluation in the Result monad.
module Main

import Std.Parser (..)

-- ------------------------------------------------------------ syntax tree

type Expr
  = Lit Int
  | BinOp Char Expr Expr
  deriving (Show)

-- ------------------------------------------------------------ parser

operator : String -> Unit -> <ParseInput, Fail> (Expr -> Expr -> Expr)
operator ops () =
  let op = lexeme (\_ -> oneOf ops)
  BinOp op

expr : Unit -> <ParseInput, Fail> Expr
expr () = chainl1 term (operator "+-")

term : Unit -> <ParseInput, Fail> Expr
term () = chainl1 factor (operator "*/")

factor : Unit -> <ParseInput, Fail> Expr
factor () = alt (\_ -> Lit (lexeme integer)) (\_ -> between (\_ -> symbol "(") (\_ -> symbol ")") expr)

program : Unit -> <ParseInput, Fail> Expr
program () =
  spaces ()
  let e = expr ()
  eof ()
  e

-- ------------------------------------------------------------ evaluation

eval : Expr -> Result String Int
eval (Lit n) = Ok n
eval (BinOp op a b) =
  eval a >>= (\x ->
    eval b >>= (\y ->
      match op with
        '+' -> Ok (x + y)
        '-' -> Ok (x - y)
        '*' -> Ok (x * y)
        _ | y == 0 -> Err "division by zero"
          | otherwise -> Ok (x / y)))

calculate : String -> String
calculate src = match runParser program src with
  Ok e -> match eval e with
    Ok v -> "${src} = ${v}"
    Err msg -> "${src}: ${msg}"
  Err msg -> "${src}: ${msg}"

main () =
  forEach ["1 + 2 * 3", "(1 + 2) * 3", "100 / (5 - 5)", "2 * (3 + 4) - 10 / 2", "1 +"] (\s ->
    println (calculate s))
  printLn (runParser expr "1+2")
