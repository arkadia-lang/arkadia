-- Monadic parser combinators (higher-kinded type classes) and an
-- expression evaluator using pattern matching.
module Main

type Parser a = Parser (List Char -> Option (a, List Char))

runParser : Parser a -> List Char -> Option (a, List Char)
runParser (Parser p) input = p input

instance Functor Parser where
  map f (Parser p) = Parser (\input -> match p input with
    None -> None
    Some (x, rest) -> Some (f x, rest))

instance Applicative Parser where
  pure x = Parser (\input -> Some (x, input))
  pf <*> px = pf >>= (\f -> map f px)

instance Monad Parser where
  Parser p >>= f = Parser (\input -> match p input with
    None -> None
    Some (x, rest) -> runParser (f x) rest)

-- choice: try the first parser, then the second
infixl 3 <|>

(<|>) : Parser a -> Parser a -> Parser a
Parser p <|> Parser q = Parser (\input -> match p input with
  None -> q input
  result -> result)

-- `ok` runs later, inside the parser, so it must be pure: `<>`
satisfy : (Char -> <> Bool) -> Parser Char
satisfy ok = Parser (\input -> match input with
  c :: rest | ok c -> Some (c, rest)
  _ -> None)

char : Char -> Parser Char
char c = satisfy (\d -> d == c)

many : Parser a -> Parser (List a)
many p = many1 p <|> pure []

many1 : Parser a -> Parser (List a)
many1 p = p >>= (\x -> map (\xs -> x :: xs) (many p))

spaces : Parser Unit
spaces = map (const ()) (many (satisfy isSpace))

token : Parser a -> Parser a
token p = p >>= (\x -> map (const x) spaces)

symbol : Char -> Parser Char
symbol c = token (char c)

number : Parser Int
number = token (map (\ds -> withDefault 0 (parseInt (fromChars ds))) (many1 (satisfy isDigit)))

-- ------------------------------------------------------------ syntax tree

type Expr
  = Lit Int
  | BinOp Char Expr Expr
  deriving (Show)

-- chainl1: left-associative operators
chainl1 : Parser Expr -> Parser Char -> Parser Expr
chainl1 p op =
  let rest acc = (op >>= (\o -> p >>= (\rhs -> rest (BinOp o acc rhs)))) <|> pure acc
  p >>= rest

expr : Unit -> Parser Expr
expr () = chainl1 (term ()) (symbol '+' <|> symbol '-')

term : Unit -> Parser Expr
term () = chainl1 (factor ()) (symbol '*' <|> symbol '/')

factor : Unit -> Parser Expr
factor () =
  map Lit number <|> Parser (\input ->
    runParser (symbol '(' >>= (\_ -> expr () >>= (\e -> map (const e) (symbol ')')))) input)

eval : Expr -> Result String Int
eval (Lit n) = Ok n
eval (BinOp op a b) =
  eval a >>= (\x ->
    eval b >>= (\y ->
      match op with
        '+' -> Ok (x + y)
        '-' -> Ok (x - y)
        '*' -> Ok (x * y)
        _ | y == 0 -> Err "division by zero"
          | otherwise -> Ok (x / y)))

calculate : String -> String
calculate src = match runParser (spaces >>= (\_ -> expr ())) (chars src) with
  Some (e, []) -> match eval e with
    Ok v -> "${src} = ${v}"
    Err msg -> "${src}: ${msg}"
  _ -> "${src}: syntax error"

main () =
  forEach ["1 + 2 * 3", "(1 + 2) * 3", "100 / (5 - 5)", "2 * (3 + 4) - 10 / 2", "1 +"] (\s ->
    println (calculate s))
  printLn (runParser (expr ()) (chars "1+2"))
