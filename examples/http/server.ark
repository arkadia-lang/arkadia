-- A small TODO web app: a JSON API and a static page.
--
--   cd examples/http && ark run server.ark
--   curl localhost:8080/api/todos
--   curl -X POST localhost:8080/api/todos -d '{"title": "write docs"}'
--   curl -X PATCH localhost:8080/api/todos/1
--   curl -X DELETE localhost:8080/api/todos/1
--
-- The TODO list lives in a State effect handled around the whole server:
-- handlers run one at a time, so they can share it without locking.
module Main

import Std.Http
import Std.Json as Json
import Std.State as St

type Todo = Todo { id : Int, title : String, done : Bool }
  deriving (Json.ToJson)

-- the body of POST /api/todos
type NewTodo = NewTodo { title : String }
  deriving (Json.FromJson)

-- the todos, newest first
type Store = Store { nextId : Int, todos : List Todo }

-- A handler that uses the store.
alias App e = Request -> <IO, Fail, Halt, St.State Store | e> Response

-- The :id parameter, or 400.
idParam : Request -> <Halt> Int
idParam req = parseInt (param "id" req) |> orHalt (badRequest "id must be a number")

listTodos : App e
listTodos _ = jsonOf (reverse (St.get ()).todos)

createTodo : App e
createTodo req =
  let new : NewTodo = bodyAs req |> orHaltWith (\e -> badRequest "invalid body: ${e}")
  let store = St.get ()
  let todo = Todo { id = store.nextId, title = new.title, done = False }
  St.put (Store { nextId = store.nextId + 1, todos = todo :: store.todos })
  withStatus 201 (jsonOf todo)

-- Apply f to the todo with the request's id; 404 if there is none.
updateTodo : (Todo -> <> List Todo) -> Request -> <St.State Store, Halt> Todo
updateTodo f req =
  let id = idParam req
  let store = St.get ()
  let todo = find (\t -> t.id == id) store.todos |> orHalt notFound
  St.put { store | todos = concatMap (\t -> match t.id == id with
    True -> f t
    False -> [t]) store.todos }
  todo

toggleTodo : App e
toggleTodo req =
  let todo = updateTodo (\t -> [{ t | done = not t.done }]) req
  jsonOf { todo | done = not todo.done }

deleteTodo : App e
deleteTodo req =
  let _ = updateTodo (\_ -> []) req
  noContent

hello : Handler e
hello req = text "Hello, ${withDefault "world" (query "name" req)}!"

app : App e
app = logRequests (router (scope "/api"
  [ get "/todos" listTodos
  , post "/todos" createTodo
  , patch "/todos/:id" toggleTodo
  , delete "/todos/:id" deleteTodo
  , get "/hello" hello
  ] ++ [staticDir "/" "public"]))

main () =
  let port = withDefault "8080" (getEnv "PORT")
  let _ = St.runState (Store { nextId = 1, todos = [] }) (\_ -> serve ":${port}" app)
  ()
