-- Formatting numbers for people.
--
--   import Std.Format (..)
--   fixed 2 3.14159       -- "3.14"
--   grouped 1234567       -- "1,234,567"
--   padInt 3 7            -- "007"
--   percent 1 0.256       -- "25.6%"
--   byteSize 1536         -- "1.5 KiB"
module Std.Format

-- A float with a fixed number of digits after the point (rounded).
foreign fixed : Int -> Float -> String = "rt.FormatFixed"

-- A float in scientific notation with a number of digits after the point:
-- scientific 2 1234.5 is "1.23e+03".
foreign scientific : Int -> Float -> String = "rt.FormatScientific"

-- An integer in a base from 2 to 36 (lowercase digits).
foreign intBase : Int -> Int -> String = "rt.FormatIntBase"

-- Parse an integer written in a base from 2 to 36.
foreign parseIntBase : Int -> String -> Option Int = "rt.ParseIntBase"

hex : Int -> String
hex n = intBase 16 n

binary : Int -> String
binary n = intBase 2 n

-- Digits grouped by thousands with a separator: groupedWith "_" 1000000 is
-- "1_000_000".
groupedWith : String -> Int -> String
groupedWith sep n = match n < 0 with
  True -> "-" ++ groupDigits sep (chars (showInt (negate n)))
  False -> groupDigits sep (chars (showInt n))

private groupDigits : String -> List Char -> String
groupDigits sep ds =
  let n = length ds
  let step (i, acc) d = match i > 0 && (n - i) % 3 == 0 with
    True -> (i + 1, acc ++ sep ++ charToString d)
    False -> (i + 1, acc ++ charToString d)
  snd (foldl step (0, "") ds)

-- Digits grouped by thousands with commas.
grouped : Int -> String
grouped n = groupedWith "," n

-- An integer padded with zeros to a width: padInt 3 7 is "007".
padInt : Int -> Int -> String
padInt width n = match n < 0 with
  True -> "-" ++ padInt (width - 1) (negate n)
  False ->
    let s = showInt n
    replicateString (width - stringLength s) "0" ++ s

private replicateString : Int -> String -> String
replicateString n s = joinWith "" (replicate n s)

-- A ratio as a percentage: percent 1 0.256 is "25.6%".
percent : Int -> Float -> String
percent digits x = fixed digits (x * 100.0) ++ "%"

-- A size in bytes with binary units: byteSize 1536 is "1.5 KiB".
byteSize : Int -> String
byteSize n = match n < 1024 with
  True -> "${n} B"
  False -> scaled (toFloat n / 1024.0) ["KiB", "MiB", "GiB", "TiB", "PiB"]

private scaled : Float -> List String -> String
scaled x units = match units with
  [u] -> trimZeros (fixed 1 x) ++ " " ++ u
  u :: more | x < 1024.0 -> trimZeros (fixed 1 x) ++ " " ++ u
            | otherwise -> scaled (x / 1024.0) more
  [] -> fixed 1 x

private trimZeros : String -> String
trimZeros s = match endsWith ".0" s with
  True -> fromChars (take (stringLength s - 2) (chars s))
  False -> s
