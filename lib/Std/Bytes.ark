-- Immutable byte strings, for binary data such as random bytes, hashes
-- and decoded Base64. A String is always text; convert between the two
-- explicitly. Import qualified: several names clash with the Prelude.
--
--   import Std.Bytes as Bytes
--   let b = Bytes.fromString "hé"     -- the UTF-8 encoding
--   Bytes.toList b                    -- [104, 195, 169]
--   Bytes.toString b                  -- Ok "hé"
--   Bytes.toString (Bytes.fromList [255])   -- Err "invalid UTF-8"
module Std.Bytes

type Bytes

foreign empty : Bytes = "rt.BytesEmpty"

-- The UTF-8 encoding of a string.
foreign fromString : String -> Bytes = "rt.BytesFromString"

-- Decode UTF-8 text; Err when the bytes are not valid UTF-8.
foreign toString : Bytes -> Result String String = "rt.BytesToString"

-- Bytes from integers in 0 .. 255; any other value is a runtime error.
foreign fromList : List Int -> Bytes = "rt.BytesFromList"

-- The bytes as integers in 0 .. 255.
foreign toList : Bytes -> List Int = "rt.BytesToList"
foreign length : Bytes -> Int = "rt.BytesLength"

-- The byte at an index, or None when it is out of range.
foreign get : Int -> Bytes -> Option Int = "rt.BytesGet"

-- The bytes from index start up to (not including) end.
foreign slice : Int -> Int -> Bytes -> Bytes = "rt.BytesSlice"
foreign append : Bytes -> Bytes -> Bytes = "rt.BytesAppend"

private foreign primEq : Bytes -> Bytes -> Bool = "rt.BytesEq"
private foreign primCompare : Bytes -> Bytes -> Ordering = "rt.BytesCompare"

isEmpty : Bytes -> Bool
isEmpty b = length b == 0

-- Values that functions on binary data (hashes, encodings) accept: a
-- String stands for its UTF-8 encoding.
class ToBytes a where
  toBytes : a -> Bytes

instance ToBytes Bytes where
  toBytes b = b

instance ToBytes String where
  toBytes s = fromString s

instance Eq Bytes where
  a == b = primEq a b

instance Ord Bytes where
  compare a b = primCompare a b

instance Show Bytes where
  show b = "Bytes.fromList " ++ show (toList b)

instance Display Bytes where
  display b = show b

instance Semigroup Bytes where
  a ++ b = append a b

instance Monoid Bytes where
  empty = Std.Bytes.empty
