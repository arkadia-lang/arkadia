-- Persistent ordered sets, meant to be imported qualified:
--
--   import Std.Set
--   let s = Set.fromList [3, 1, 2]
--   Set.member 2 s            -- True
--   s ++ Set.fromList [4]     -- union
--
-- Functions that visit several elements do so in ascending order.
module Std.Set

import Std.Map as M

type Set a = Set (M.Map a Unit)

empty : Set a
empty = Set M.empty

singleton : a -> Set a
singleton x = Set (M.singleton x ())

insert : Ord a => a -> Set a -> Set a
insert x (Set m) = Set (M.insert x () m)

delete : Ord a => a -> Set a -> Set a
delete x (Set m) = Set (M.delete x m)

member : Ord a => a -> Set a -> Bool
member x (Set m) = M.member x m

fromList : Ord a => List a -> Set a
fromList xs = Prelude.foldl (\s x -> insert x s) empty xs

union : Ord a => Set a -> Set a -> Set a
union (Set a) (Set b) = Set (M.union a b)

intersection : Ord a => Set a -> Set a -> Set a
intersection a b = fromList (Prelude.filter (\x -> member x b) (toList a))

difference : Ord a => Set a -> Set a -> Set a
difference a b = fromList (Prelude.filter (\x -> not (member x b)) (toList a))

filter : Ord a => (a -> Bool) -> Set a -> Set a
filter p s = fromList (Prelude.filter p (toList s))

notMember : Ord a => a -> Set a -> Bool
notMember x s = not (member x s)

map : Ord b => (a -> b) -> Set a -> Set b
map f s = fromList (Prelude.map f (toList s))

partition : Ord a => (a -> Bool) -> Set a -> (Set a, Set a)
partition p s = (filter p s, filter (\x -> not (p x)) s)

unions : Ord a => List (Set a) -> Set a
unions ss = Prelude.foldl union empty ss

isSubsetOf : Ord a => Set a -> Set a -> Bool
isSubsetOf a b = Prelude.all (\x -> member x b) (toList a)

disjoint : Ord a => Set a -> Set a -> Bool
disjoint a b = isEmpty (intersection a b)

lookupMin : Set a -> Option a
lookupMin (Set m) = Prelude.map fst (M.lookupMin m)

lookupMax : Set a -> Option a
lookupMax (Set m) = Prelude.map fst (M.lookupMax m)

-- The largest element smaller than x, etc.
lookupLT : Ord a => a -> Set a -> Option a
lookupLT x (Set m) = Prelude.map fst (M.lookupLT x m)

lookupLE : Ord a => a -> Set a -> Option a
lookupLE x (Set m) = Prelude.map fst (M.lookupLE x m)

lookupGT : Ord a => a -> Set a -> Option a
lookupGT x (Set m) = Prelude.map fst (M.lookupGT x m)

lookupGE : Ord a => a -> Set a -> Option a
lookupGE x (Set m) = Prelude.map fst (M.lookupGE x m)

toDescList : Set a -> List a
toDescList s = Prelude.reverse (toList s)

instance Foldable Set where
  foldr f z s = Prelude.foldr f z (toList s)
  foldl f z s = Prelude.foldl f z (toList s)
  toList (Set m) = M.keys m
  length (Set m) = length m
  isEmpty (Set m) = isEmpty m

instance Eq a => Eq (Set a) where
  a == b = toList a == toList b

instance Ord a => Ord (Set a) where
  compare a b = compare (toList a) (toList b)

instance Show a => Show (Set a) where
  show s = "Set.fromList " ++ show (toList s)

instance Show a => Display (Set a) where
  display s = show s

instance Ord a => Semigroup (Set a) where
  a ++ b = union a b

instance Ord a => Monoid (Set a) where
  empty = Set M.empty
