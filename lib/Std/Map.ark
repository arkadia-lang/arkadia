-- Persistent ordered maps (AVL trees).
--
--   import Std.Map as Map
--   let m = Map.fromList [(1, "one"), (2, "two")]
--   Map.lookup 1 m   -- Some "one"
module Std.Map

type Map k v = Tip | Bin Int k v (Map k v) (Map k v)

empty : Map k v
empty = Tip

singleton : k -> v -> Map k v
singleton k v = Bin 1 k v Tip Tip

size : Map k v -> Int
size m = Prelude.foldl (\n _ -> n + 1) 0 (values m)

isEmpty : Map k v -> Bool
isEmpty Tip = True
isEmpty _ = False

private height : Map k v -> Int
height Tip = 0
height (Bin h _ _ _ _) = h

private node : k -> v -> Map k v -> Map k v -> Map k v
node k v l r = Bin (1 + Prelude.max (height l) (height r)) k v l r

private rotateRight : Map k v -> Map k v
rotateRight (Bin _ k v (Bin _ lk lv ll lr) r) = node lk lv ll (node k v lr r)
rotateRight m = m

private rotateLeft : Map k v -> Map k v
rotateLeft (Bin _ k v l (Bin _ rk rv rl rr)) = node rk rv (node k v l rl) rr
rotateLeft m = m

private balance : k -> v -> Map k v -> Map k v -> Map k v
balance k v l r
  | height l > height r + 1 = match l with
      Bin _ _ _ ll lr | height lr > height ll -> rotateRight (node k v (rotateLeft l) r)
      _ -> rotateRight (node k v l r)
  | height r > height l + 1 = match r with
      Bin _ _ _ rl rr | height rl > height rr -> rotateLeft (node k v l (rotateRight r))
      _ -> rotateLeft (node k v l r)
  | otherwise = node k v l r

insert : Ord k => k -> v -> Map k v -> Map k v
insert k v Tip = singleton k v
insert k v (Bin h k2 v2 l r) = match compare k k2 with
  LT -> balance k2 v2 (insert k v l) r
  GT -> balance k2 v2 l (insert k v r)
  EQ -> Bin h k v l r

-- Insert, combining with an existing value: f new old.
insertWith : Ord k => (v -> v -> v) -> k -> v -> Map k v -> Map k v
insertWith f k v m = match lookup k m with
  None -> insert k v m
  Some old -> insert k (f v old) m

lookup : Ord k => k -> Map k v -> Option v
lookup _ Tip = None
lookup k (Bin _ k2 v l r) = match compare k k2 with
  LT -> lookup k l
  GT -> lookup k r
  EQ -> Some v

findWithDefault : Ord k => v -> k -> Map k v -> v
findWithDefault d k m = withDefault d (lookup k m)

member : Ord k => k -> Map k v -> Bool
member k m = isSome (lookup k m)

private minBinding : Map k v -> Option (k, v)
minBinding Tip = None
minBinding (Bin _ k v Tip _) = Some (k, v)
minBinding (Bin _ _ _ l _) = minBinding l

delete : Ord k => k -> Map k v -> Map k v
delete _ Tip = Tip
delete k (Bin _ k2 v l r) = match compare k k2 with
  LT -> balance k2 v (delete k l) r
  GT -> balance k2 v l (delete k r)
  EQ -> match minBinding r with
    None -> l
    Some (mk, mv) -> balance mk mv l (delete mk r)

-- Update or remove a binding.
alter : Ord k => (Option v -> Option v) -> k -> Map k v -> Map k v
alter f k m = match f (lookup k m) with
  None -> delete k m
  Some v -> insert k v m

adjust : Ord k => (v -> v) -> k -> Map k v -> Map k v
adjust f k m = match lookup k m with
  None -> m
  Some v -> insert k (f v) m

fromList : Ord k => List (k, v) -> Map k v
fromList kvs = Prelude.foldl (\m (k, v) -> insert k v m) Tip kvs

-- Bindings in ascending key order.
toList : Map k v -> List (k, v)
toList m = foldrWithKey (\k v acc -> (k, v) :: acc) [] m

keys : Map k v -> List k
keys m = foldrWithKey (\k _ acc -> k :: acc) [] m

values : Map k v -> List v
values m = foldrWithKey (\_ v acc -> v :: acc) [] m

foldrWithKey : (k -> v -> b -> b) -> b -> Map k v -> b
foldrWithKey _ z Tip = z
foldrWithKey f z (Bin _ k v l r) = foldrWithKey f (f k v (foldrWithKey f z r)) l

foldlWithKey : (b -> k -> v -> b) -> b -> Map k v -> b
foldlWithKey _ z Tip = z
foldlWithKey f z (Bin _ k v l r) = foldlWithKey f (f (foldlWithKey f z l) k v) r

mapWithKey : (k -> a -> b) -> Map k a -> Map k b
mapWithKey _ Tip = Tip
mapWithKey f (Bin h k v l r) = Bin h k (f k v) (mapWithKey f l) (mapWithKey f r)

filter : Ord k => (v -> Bool) -> Map k v -> Map k v
filter p m = filterWithKey (\_ v -> p v) m

filterWithKey : Ord k => (k -> v -> Bool) -> Map k v -> Map k v
filterWithKey p m = foldlWithKey (\acc k v -> match p k v with
  True -> insert k v acc
  False -> acc) Tip m

-- Left-biased union.
union : Ord k => Map k v -> Map k v -> Map k v
union a b = foldlWithKey (\acc k v -> insert k v acc) b a

unionWith : Ord k => (v -> v -> v) -> Map k v -> Map k v -> Map k v
unionWith f a b = foldlWithKey (\acc k v -> insertWith f k v acc) b a

notMember : Ord k => k -> Map k v -> Bool
notMember k m = not (member k m)

-- Update or remove an existing binding; absent keys are left alone.
update : Ord k => (v -> Option v) -> k -> Map k v -> Map k v
update f k m = match lookup k m with
  None -> m
  Some v -> match f v with
    None -> delete k m
    Some v2 -> insert k v2 m

-- Build a map, combining the values of duplicate keys: f new old.
fromListWith : Ord k => (v -> v -> v) -> List (k, v) -> Map k v
fromListWith f kvs = Prelude.foldl (\m (k, v) -> insertWith f k v m) Tip kvs

-- Group list elements by a key, keeping their order.
groupBy : Ord k => (a -> k) -> List a -> Map k (List a)
groupBy f xs = map Prelude.reverse (Prelude.foldl (\m x -> insertWith (\new old -> new ++ old) (f x) [x] m) Tip xs)

-- Bindings in descending key order.
toDescList : Map k v -> List (k, v)
toDescList m = foldlWithKey (\acc k v -> (k, v) :: acc) [] m

lookupMin : Map k v -> Option (k, v)
lookupMin m = minBinding m

lookupMax : Map k v -> Option (k, v)
lookupMax Tip = None
lookupMax (Bin _ k v _ Tip) = Some (k, v)
lookupMax (Bin _ _ _ _ r) = lookupMax r

-- The binding with the largest key smaller than k.
lookupLT : Ord k => k -> Map k v -> Option (k, v)
lookupLT k m = lookupBelow (\c -> c == GT) k m None

-- The binding with the largest key smaller than or equal to k.
lookupLE : Ord k => k -> Map k v -> Option (k, v)
lookupLE k m = lookupBelow (\c -> c != LT) k m None

-- The binding with the smallest key greater than k.
lookupGT : Ord k => k -> Map k v -> Option (k, v)
lookupGT k m = lookupAbove (\c -> c == LT) k m None

-- The binding with the smallest key greater than or equal to k.
lookupGE : Ord k => k -> Map k v -> Option (k, v)
lookupGE k m = lookupAbove (\c -> c != GT) k m None

-- `ok (compare k k2)` says whether the node key k2 is a candidate.
private lookupBelow : Ord k => (Ordering -> Bool) -> k -> Map k v -> Option (k, v) -> Option (k, v)
lookupBelow _ _ Tip best = best
lookupBelow ok k (Bin _ k2 v l r) best
  | ok (compare k k2) = lookupBelow ok k r (Some (k2, v))
  | otherwise = lookupBelow ok k l best

private lookupAbove : Ord k => (Ordering -> Bool) -> k -> Map k v -> Option (k, v) -> Option (k, v)
lookupAbove _ _ Tip best = best
lookupAbove ok k (Bin _ k2 v l r) best
  | ok (compare k k2) = lookupAbove ok k l (Some (k2, v))
  | otherwise = lookupAbove ok k r best

-- Keep the values mapped to Some.
filterMap : Ord k => (a -> Option b) -> Map k a -> Map k b
filterMap f m = foldlWithKey (\acc k v -> match f v with
  Some w -> insert k w acc
  None -> acc) Tip m

partition : Ord k => (v -> Bool) -> Map k v -> (Map k v, Map k v)
partition p m = (filter p m, filter (\v -> not (p v)) m)

mapKeys : Ord k2 => (k -> k2) -> Map k v -> Map k2 v
mapKeys f m = foldlWithKey (\acc k v -> insert (f k) v acc) Tip m

-- Left-biased union of many maps.
unions : Ord k => List (Map k v) -> Map k v
unions ms = Prelude.foldl (\acc m -> union acc m) Tip ms

-- Bindings of the first map whose keys are also in the second.
intersection : Ord k => Map k a -> Map k b -> Map k a
intersection a b = filterWithKey (\k _ -> member k b) a

intersectionWith : Ord k => (a -> b -> c) -> Map k a -> Map k b -> Map k c
intersectionWith f a b = foldlWithKey (\acc k x -> match lookup k b with
  Some y -> insert k (f x y) acc
  None -> acc) Tip a

-- Bindings of the first map whose keys are not in the second.
difference : Ord k => Map k a -> Map k b -> Map k a
difference a b = filterWithKey (\k _ -> not (member k b)) a

-- Run an action for every binding in ascending key order.
forEachWithKey : Map k v -> (k -> v -> Unit) -> Unit
forEachWithKey m f = foldlWithKey (\_ k v -> f k v) () m

instance Functor (Map k) where
  map f m = mapWithKey (\_ v -> f v) m

instance Foldable (Map k) where
  foldr f z m = foldrWithKey (\_ v acc -> f v acc) z m
  foldl f z m = foldlWithKey (\acc _ v -> f acc v) z m

instance (Eq k, Eq v) => Eq (Map k v) where
  a == b = toList a == toList b

instance (Ord k, Ord v) => Ord (Map k v) where
  compare a b = compare (toList a) (toList b)

instance (Show k, Show v) => Show (Map k v) where
  show m = "Map.fromList " ++ show (toList m)
