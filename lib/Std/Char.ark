-- Character classification and conversion, meant to be imported qualified:
--
--   import Std.Char as Char
--   Char.digitToInt 'f'   -- Some 15
--
-- `isDigit`, `isAlpha`, `isSpace`, `isUpper`, `isLower`, `charCode` and
-- `fromCharCode` live in the Prelude.
module Std.Char

foreign toUpper : Char -> Char = "rt.CharToUpper"
foreign toLower : Char -> Char = "rt.CharToLower"
-- Punctuation or a symbol such as '+' or '$'.
foreign isPunctuation : Char -> Bool = "rt.CharIsPunct"
foreign isControl : Char -> Bool = "rt.CharIsControl"
foreign isPrint : Char -> Bool = "rt.CharIsPrint"

isAlphaNum : Char -> Bool
isAlphaNum c = isAlpha c || isDigit c

isAscii : Char -> Bool
isAscii c = charCode c < 128

isAsciiDigit : Char -> Bool
isAsciiDigit c = c >= '0' && c <= '9'

isAsciiLetter : Char -> Bool
isAsciiLetter c = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')

isHexDigit : Char -> Bool
isHexDigit c = isSome (digitToInt c)

isOctDigit : Char -> Bool
isOctDigit c = c >= '0' && c <= '7'

-- The value of a hexadecimal digit (either case).
digitToInt : Char -> Option Int
digitToInt c
  | c >= '0' && c <= '9' = Some (charCode c - charCode '0')
  | c >= 'a' && c <= 'f' = Some (charCode c - charCode 'a' + 10)
  | c >= 'A' && c <= 'F' = Some (charCode c - charCode 'A' + 10)
  | otherwise = None

-- The lowercase hexadecimal digit for 0 .. 15.
intToDigit : Int -> Option Char
intToDigit n
  | n >= 0 && n <= 9 = Some (fromCharCode (charCode '0' + n))
  | n >= 10 && n <= 15 = Some (fromCharCode (charCode 'a' + n - 10))
  | otherwise = None
