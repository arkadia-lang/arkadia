-- Character classification and conversion, meant to be imported qualified:
--
--   import Std.Char
--   Char.digitToInt 'f'   -- Some 15
--   Char.toCode 'A'       -- 65
--
-- The module repeats the character functions of the Prelude (`isDigit`,
-- `charCode` as `toCode`, ...) so that every one can be written
-- `Char.name`.
module Std.Char

foreign isDigit : Char -> Bool = "rt.CharIsDigit"
foreign isAlpha : Char -> Bool = "rt.CharIsAlpha"
foreign isSpace : Char -> Bool = "rt.CharIsSpace"
foreign isUpper : Char -> Bool = "rt.CharIsUpper"
foreign isLower : Char -> Bool = "rt.CharIsLower"

-- The Unicode code point.
foreign toCode : Char -> Int = "rt.CharCode"
foreign fromCode : Int -> Char = "rt.FromCharCode"

-- A string of one character.
foreign toString : Char -> String = "rt.CharToString"

foreign toUpper : Char -> Char = "rt.CharToUpper"
foreign toLower : Char -> Char = "rt.CharToLower"
-- Punctuation or a symbol such as '+' or '$'.
foreign isPunctuation : Char -> Bool = "rt.CharIsPunct"
foreign isControl : Char -> Bool = "rt.CharIsControl"
foreign isPrint : Char -> Bool = "rt.CharIsPrint"

isAlphaNum : Char -> Bool
isAlphaNum c = isAlpha c || isDigit c

isAscii : Char -> Bool
isAscii c = toCode c < 128

isAsciiDigit : Char -> Bool
isAsciiDigit c = c >= '0' && c <= '9'

isAsciiLetter : Char -> Bool
isAsciiLetter c = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')

isHexDigit : Char -> Bool
isHexDigit c = isSome (digitToInt c)

isOctDigit : Char -> Bool
isOctDigit c = c >= '0' && c <= '7'

-- The value of a hexadecimal digit (either case).
digitToInt : Char -> Option Int
digitToInt c
  | c >= '0' && c <= '9' = Some (toCode c - toCode '0')
  | c >= 'a' && c <= 'f' = Some (toCode c - toCode 'a' + 10)
  | c >= 'A' && c <= 'F' = Some (toCode c - toCode 'A' + 10)
  | otherwise = None

-- The lowercase hexadecimal digit for 0 .. 15.
intToDigit : Int -> Option Char
intToDigit n
  | n >= 0 && n <= 9 = Some (fromCode (toCode '0' + n))
  | n >= 10 && n <= 15 = Some (fromCode (toCode 'a' + n - 10))
  | otherwise = None
