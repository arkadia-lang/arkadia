-- Wall-clock time, sleeping and timing. Times are seconds since the Unix
-- epoch as Float. (`clock` in the Prelude measures seconds since start.)
--
--   import Std.Time
--   let (result, secs) = measure (\_ -> work ())
--   println "took ${formatDuration secs}"
module Std.Time

-- Seconds since the Unix epoch.
foreign now : Unit -> <IO> Float = "rt.UnixTime"
-- Milliseconds since the Unix epoch.
foreign nowMillis : Unit -> <IO> Int = "rt.UnixMillis"
-- Pause for a number of seconds. Other tasks keep running, and a
-- cancellation (see Std.Task) interrupts the pause.
foreign sleep : Float -> <IO> Unit = "ev:rt.Sleep"
-- Format with a Go layout string, e.g. "2006-01-02 15:04:05".
foreign formatUtc : String -> Float -> String = "rt.FormatTimeUTC"
foreign formatLocal : String -> Float -> String = "rt.FormatTimeLocal"
-- (year, month, day, hour, minute, second) in UTC.
foreign toUtcParts : Float -> (Int, Int, Int, Int, Int, Int) = "rt.TimeParts"

-- Parse with a Go layout string, as UTC or local time.
foreign parseUtc : String -> String -> Option Float = "rt.TimeParseUTC"
foreign parseLocal : String -> String -> Option Float = "rt.TimeParseLocal"
-- Parse RFC 3339: "2026-10-17T09:30:00Z", "2026-10-17T18:30:00.5+09:00".
foreign parseIso : String -> Option Float = "rt.TimeParseIso"
-- The time of (year, month, day, hour, minute, second) in UTC. Values out
-- of range are normalized: month 13 is January of the next year.
foreign fromUtcParts : (Int, Int, Int, Int, Int, Int) -> Float = "rt.TimeFromParts"
-- The day of the week in UTC, from 0 (Sunday) to 6 (Saturday).
foreign weekday : Float -> Int = "rt.TimeWeekday"
-- The day of the year in UTC, from 1.
foreign dayOfYear : Float -> Int = "rt.TimeDayOfYear"
-- The offset of the local time zone from UTC, in seconds, at a time.
foreign localOffset : Float -> Int = "rt.TimeLocalOffset"
-- Add calendar months in UTC (Jan 31 + 1 month is Mar 2 or 3).
foreign addMonths : Int -> Float -> Float = "rt.TimeAddMonths"

-- RFC 3339 in UTC: "2026-10-17T09:30:00Z"
formatIso : Float -> String
formatIso t = formatUtc "2006-01-02T15:04:05Z07:00" t

-- The date in UTC: "2026-10-17"
formatDate : Float -> String
formatDate t = formatUtc "2006-01-02" t

-- The time of a date at midnight UTC.
date : Int -> Int -> Int -> Float
date y m d = fromUtcParts (y, m, d, 0, 0, 0)

-- Midnight UTC of the day of a time.
startOfDay : Float -> Float
startOfDay t =
  let (y, m, d, _, _, _) = toUtcParts t
  date y m d

minute : Float
minute = 60.0

hour : Float
hour = 3600.0

day : Float
day = 86400.0

addDays : Int -> Float -> Float
addDays n t = t + toFloat n * day

-- Whole days from one time to another.
daysBetween : Float -> Float -> Int
daysBetween a b = floor ((startOfDay b - startOfDay a) / day + 0.5)

-- Run a computation and return its result with the elapsed seconds.
measure : (Unit -> <IO | e> a) -> <IO | e> (a, Float)
measure action =
  let start = clock ()
  let result = action ()
  (result, clock () - start)

-- A short human-readable duration: "250ms", "1.50s", "2m05s", "1h02m".
formatDuration : Float -> String
formatDuration secs
  | secs < 0.001 = "${round (secs * 1000000.0)}µs"
  | secs < 1.0 = "${round (secs * 1000.0)}ms"
  | secs < 60.0 = "${twoDecimals secs}s"
  | secs < 3600.0 =
      let s = round secs
      "${s / 60}m${pad2 (s % 60)}s"
  | otherwise =
      let m = round (secs / 60.0)
      "${m / 60}h${pad2 (m % 60)}m"

private twoDecimals : Float -> String
twoDecimals x =
  let hundredths = round (x * 100.0)
  "${hundredths / 100}.${pad2 (hundredths % 100)}"

private pad2 : Int -> String
pad2 n
  | n < 10 = "0${n}"
  | otherwise = show n
