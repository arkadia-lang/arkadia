{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arkadia",
  "scopeName": "source.arkadia",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#rows" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.arkadia", "match": "--(?![!#$%&*+./<=>?@\\\\^|~:]).*$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.triple.arkadia", "begin": "\"\"\"", "end": "\"\"\"" },
        {
          "name": "string.quoted.double.arkadia",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.arkadia", "match": "\\\\(n|t|r|0|\\\\|\"|'|\\$|u\\{[0-9a-fA-F]+\\})" },
            {
              "name": "meta.interpolation.arkadia",
              "begin": "\\$\\{", "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.arkadia" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.arkadia" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.arkadia",
      "match": "'(\\\\(n|t|r|0|\\\\|\"|'|u\\{[0-9a-fA-F]+\\})|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.arkadia", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b" },
        { "name": "constant.numeric.integer.arkadia", "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|\\d[\\d_]*)\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(?:(private)\\s+)?([a-z_][A-Za-z0-9_']*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "storage.modifier.arkadia" },
            "2": { "name": "entity.name.function.arkadia" },
            "3": { "name": "keyword.operator.type.arkadia" }
          }
        },
        {
          "match": "\\b(type|alias|effect|class)\\s+([A-Z][A-Za-z0-9_']*)",
          "captures": {
            "1": { "name": "keyword.declaration.arkadia" },
            "2": { "name": "entity.name.type.arkadia" }
          }
        },
        {
          "match": "^(module)\\s+([A-Z][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.other.module.arkadia" },
            "2": { "name": "entity.name.namespace.arkadia" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.arkadia", "match": "\\b(match|with|handle|return|let|where)\\b" },
        { "name": "keyword.declaration.arkadia", "match": "\\b(module|import|as|type|alias|class|instance|effect|foreign|infixl|infixr|infix|deriving|test)\\b" },
        { "name": "storage.modifier.arkadia", "match": "\\bprivate\\b" },
        { "name": "constant.language.arkadia", "match": "\\b(True|False|otherwise)\\b" }
      ]
    },
    "rows": {
      "name": "meta.effect-row.arkadia",
      "match": "(?<=->\\s*)<[^<>]*>",
      "captures": { "0": { "name": "storage.type.effect.arkadia" } }
    },
    "types": {
      "name": "entity.name.type.arkadia",
      "match": "\\b[A-Z][A-Za-z0-9_']*(\\.[A-Z][A-Za-z0-9_']*)*\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.arkadia", "match": "->|=>|\\\\" },
        { "name": "keyword.operator.guard.arkadia", "match": "(?<![!#$%&*+./<=>?@\\\\^|~:-])\\|(?![!#$%&*+./<=>?@\\\\^|~:-])" },
        { "name": "keyword.operator.arkadia", "match": "[!#$%&*+./<=>?@\\\\^|~:-]+" }
      ]
    }
  }
}
