{
  "comments": { "lineComment": "--", "blockComment": ["{-", "-}"] },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^.*(=|->|\\bwhere|\\bwith)\\s*(--.*)?$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "onEnterRules": [
    { "beforeText": "^.*(=|->|\\bwhere|\\bwith)\\s*$", "action": { "indent": "indent" } }
  ]
}
