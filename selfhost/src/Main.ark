-- arkc: the Arkadia compiler, written in Arkadia.
module Main

import Ark.Util
import Ark.Ast
import Ark.Lexer
import Ark.Parser
import Ark.Fixity
import Ark.Types
import Ark.Check
import Ark.Loader
import Ark.Render
import Ark.Debug
import Ark.Project
import Ark.Build
import Std.IO
import Std.Map as Map

version : String
version = "0.1.0"

usage : String
usage = """
arkc — the Arkadia compiler, written in Arkadia

Usage:
  arkc <command> [arguments]

Commands:
  build [file.ark]   compile the project (or a single file) to a native executable
  run [file.ark]     build and run; arguments after -- are passed to the program
  check [file.ark]   type check without building
  test [file.ark]    run the project's tests
  emit [file.ark]    print the generated Go code
  version            print the version

Options of build and run:
  -o <file>          output executable
  -work <dir>        directory to keep the generated Go module in

The standard library and the Go runtime are looked up in $ARKADIA_ROOT, or
in a parent directory of the arkc executable.
"""

main () =
  let code = cli (args ())
  exit code

cli : List String -> <IO> Int
cli argv = match argv with
  [] ->
    eprint usage
    2
  cmd :: rest -> match cmd with
    "build" -> withRoot (\root -> cmdBuild root rest False)
    "run" -> withRoot (\root -> cmdBuild root rest True)
    "check" -> withRoot (\root -> cmdCheck root rest)
    "emit" -> withRoot (\root -> cmdEmit root rest)
    "test" -> withRoot (\root -> cmdTest root rest)
    "debug" -> withRoot (\root -> cmdDebug root rest)
    "version" -> versionCmd ()
    "--version" -> versionCmd ()
    "-v" -> versionCmd ()
    "help" -> helpCmd ()
    "-h" -> helpCmd ()
    "--help" -> helpCmd ()
    _ ->
      eprint "arkc: unknown command ${show cmd}\n\n${usage}"
      2

private versionCmd : Unit -> <IO> Int
versionCmd () =
  println "arkc ${version} (self-hosted)"
  0

private helpCmd : Unit -> <IO> Int
helpCmd () =
  print usage
  0

-- Print to standard error without a trailing newline.
eprint : String -> <IO> Unit
eprint s = match endsWith "\n" s with
  True -> eprintln (substring 0 (stringLength s - 1) s)
  False -> eprintln s

withRoot : (String -> <IO> Int) -> <IO> Int
withRoot f = match findRoot () with
  Ok root -> f root
  Err e -> failMsg e

failMsg : String -> <IO> Int
failMsg e =
  eprintln "error: ${e}"
  1

failDiags : Loader -> List Diag -> <IO> Int
failDiags l errs =
  eprint (renderDiags (loaderSources l) errs (useColor ()))
  1

-- ================================================================ targets

-- entry file ("" in project mode without one), project, search paths,
-- native files
type Target = Target String (Option Project) (List String) (List String)

resolveTarget : String -> <IO> Result String Target
resolveTarget file =
  let start = match file with
    "" -> "."
    _ -> pathDir file
  let base = match findManifest start with
    Some mp -> match resolveProject mp with
      Err e -> Err e
      Ok (proj@(Project m srcs natives)) ->
        let f = match file with
          "" -> pathJoin (manifestDir m) (manifestEntry m)
          _ -> file
        Ok (Target f (Some proj) srcs natives)
    None -> match file with
      "" -> Err "no ${manifestName} found in this directory or its parents; pass a .ark file"
      _ -> Ok (Target file None [] [])
  match (base, file) with
    (Ok (Target f p paths natives), _) | file != "" -> Ok (Target f p (pathDir file :: paths) natives)
    _ -> base

exeName : Target -> <IO> String
exeName (Target file _ _ _) =
  let abs = pathAbs file
  let b = pathBase abs
  let stem = match endsWith ".ark" b with
    True -> substring 0 (stringLength b - 4) b
    False -> b
  stem ++ "-" ++ hexOf (hashString abs)

libDir : String -> String
libDir root = pathJoin root "lib"

-- ================================================================ options

-- output, work directory, positional arguments, program arguments
type Opts = Opts String String (List String) (List String)

parseOpts : List String -> Result String Opts
parseOpts argv =
  let (before, after) = match splitOn "--" argv with
    Some (b, a) -> (b, a)
    None -> (argv, [])
  let loop xs o w = match xs with
    ("-o" :: v :: rest) -> loop rest v w
    ("-work" :: v :: rest) -> loop rest o v
    (x :: rest) | startsWith "-o=" x -> loop rest (substring 3 (stringLength x) x) w
                | startsWith "-work=" x -> loop rest o (substring 6 (stringLength x) x)
                | startsWith "-" x && x != "-" -> Err "unknown flag ${x}"
    _ -> Ok (Opts o w xs after)
  loop before "" ""

splitOn : String -> List String -> Option (List String, List String)
splitOn sep xs = splitAcc sep xs []

private splitAcc : String -> List String -> List String -> Option (List String, List String)
splitAcc sep xs acc = match xs with
  [] -> None
  x :: rest
    | x == sep -> Some (reverse acc, rest)
    | otherwise -> splitAcc sep rest (x :: acc)

firstOr : List String -> String
firstOr xs = match xs with
  x :: _ -> x
  [] -> ""

-- ================================================================ commands

cmdBuild : String -> List String -> Bool -> <IO> Int
cmdBuild root argv run = match parseOpts argv with
  Err e -> failMsg e
  Ok (Opts out work positional progArgs0) ->
    let file = firstOr positional
    let progArgs = match run with
      True -> drop 1 positional ++ progArgs0
      False -> progArgs0
    match resolveTarget file with
      Err e -> failMsg e
      Ok (t@(Target tfile proj paths natives)) ->
        let l = newLoader paths (libDir root)
        match loadFile l tfile with
          Err errs -> failDiags l errs
          Ok prog ->
            let exe = match out with
              "" -> match (run, proj) with
                (True, _) -> pathJoin (cacheDir ()) ("bin/" ++ exeName t)
                (False, Some (Project m _ _)) | file == "" -> pathJoin (manifestDir m) ("bin/" ++ manifestPackage m)
                _ ->
                  let b = pathBase tfile
                  match endsWith ".ark" b with
                    True -> substring 0 (stringLength b - 4) b
                    False -> b
              o -> o
            match makeDir (pathDir exe) with
              Err e -> failMsg e
              Ok _ -> match build root prog (BuildOptions exe work False natives) with
                Err errs -> failDiags l errs
                Ok _ -> match run with
                  False -> 0
                  True -> match execProgram exe progArgs [] with
                    Ok code -> code
                    Err e -> failMsg e

cmdCheck : String -> List String -> <IO> Int
cmdCheck root argv = match resolveTarget (firstOr argv) with
  Err e -> failMsg e
  Ok (Target tfile _ paths _) ->
    let l = newLoader paths (libDir root)
    match loadFile l tfile with
      Err errs -> failDiags l errs
      Ok (Program mods g main) -> match checkMain g main with
        [] ->
          eprintln "ok: ${length mods} modules checked"
          0
        errs -> failDiags l errs

cmdEmit : String -> List String -> <IO> Int
cmdEmit root argv = match resolveTarget (firstOr argv) with
  Err e -> failMsg e
  Ok (Target tfile _ paths _) ->
    let l = newLoader paths (libDir root)
    match loadFile l tfile with
      Err errs -> failDiags l errs
      Ok prog -> match generateGo prog False with
        Err errs -> failDiags l errs
        Ok src ->
          print src
          0

cmdTest : String -> List String -> <IO> Int
cmdTest root argv =
  let file = firstOr argv
  match resolveTarget file with
    Err e -> failMsg e
    Ok (t@(Target tfile proj paths _)) -> match (file, proj) with
      ("", Some (Project m _ _)) ->
        let testDir = pathJoin (manifestDir m) "tests"
        let mods = modulesIn (pathJoin (manifestDir m) "src") ++ modulesIn testDir
        let l = newLoader (snoc paths testDir) (libDir root)
        match loadModules l mods with
          Err errs -> failDiags l errs
          Ok prog -> runTests root l prog t
      _ ->
        let l = newLoader paths (libDir root)
        match loadFile l tfile with
          Err errs -> failDiags l errs
          Ok prog -> runTests root l prog t

runTests : String -> Loader -> Program -> Target -> <IO> Int
runTests root l (prog@(Program mods g _)) (t@(Target _ _ _ natives)) =
  -- keep only tests from the user's own modules
  let own = mapList moduleName (filter (\m -> not (startsWith "<std>" (moduleFile m))) mods)
  modifyRef (gTests g) (filter (\(TestInfo _ _ m) -> elem m own))
  match readRef (gTests g) with
    [] ->
      println "no tests found"
      0
    _ ->
      let exe = pathJoin (cacheDir ()) ("bin/test-" ++ exeName t)
      let _ = makeDir (pathDir exe)
      match build root prog (BuildOptions exe "" True natives) with
        Err errs -> failDiags l errs
        Ok _ ->
          let env = match useColor () with
            True -> []
            False -> ["NO_COLOR=1"]
          match execProgram exe [] env with
            Ok code -> code
            Err e -> failMsg e

-- ================================================================ debugging

-- Dumps used to compare the phases with the Go implementation.
cmdDebug : String -> List String -> <IO> Int
cmdDebug root argv = match argv with
  ["tokens", file] -> match readFile file with
    Err e -> failMsg e
    Ok src -> match lex file src with
      Ok toks ->
        print (concatStrings (mapList (dumpTok "") toks))
        0
      Err errs ->
        println ("ERR " ++ joinWith "\n" (mapList diagString errs))
        0
  ["ast", file] -> match readFile file with
    Err e -> failMsg e
    Ok src -> match parseModule file src with
      Ok m ->
        print (dumpModule m)
        0
      Err errs ->
        println ("ERR " ++ joinWith "\n" (mapList diagString errs))
        0
  ["types", file] ->
    let l = newLoader [pathDir file] (libDir root)
    match loadFile l file with
      Err errs ->
        print (renderDiags (loaderSources l) errs False)
        0
      Ok (Program mods g main) ->
        forEach mods (\m ->
          println ("module " ++ moduleName m)
          match Map.lookup (moduleName m) (readRef (gModules g)) with
            Some ex -> forEach (Map.toList (readRef (exportsValues ex))) (\(n, v) -> match readRef (valueSchemeRef v) with
              Some sc -> println ("  " ++ n ++ " : " ++ schemeString sc)
              None -> ())
            None -> ())
        match checkMain g main with
          [] -> ()
          errs -> print (renderDiags (loaderSources l) errs False)
        0
  _ ->
    eprintln "usage: arkc debug (tokens|ast|types) <file.ark>"
    2

dumpTok : String -> Token -> String
dumpTok ind t =
  let fl = match tokFirst t with
    True -> " F"
    False -> ""
  let sp = match tokSpace t with
    True -> " S"
    False -> ""
  let head = ind ++ show (tagOf (tokKind t)) ++ " " ++ tokText t ++ " q=" ++ tokQual t ++ " " ++ posString (tokPos t) ++ " s=" ++ tokStr t ++ fl ++ sp ++ "\n"
  head ++ concatStrings (mapList (dumpPart ind) (tokParts t))

dumpPart : String -> InterpPart -> String
dumpPart ind (InterpLit s) = ind ++ "  lit " ++ s ++ "\n"
dumpPart ind (InterpExpr toks p) = ind ++ "  expr " ++ posString p ++ "\n" ++ concatStrings (mapList (dumpTok (ind ++ "    ")) toks)
