-- Debug rendering of syntax trees (used to compare with the Go compiler).
module Ark.Debug

import Ark.Util
import Ark.Ast

dumpModule : Module -> <IO> String
dumpModule (Module name _ imports decls) =
  "module " ++ name ++ "\n" ++ concatStrings (mapList dImport imports) ++ concatStrings (mapList (\d -> dDecl d ++ "\n") decls)

dImport : Import -> String
dImport (Import p path alias names all) =
  let a = match all with
    True -> " all"
    False -> ""
  let n (ImportName np nm k nall) = " (" ++ posString np ++ " " ++ nm ++ " " ++ show k ++ (match nall with
    True -> " all"
    False -> "") ++ ")"
  "import " ++ posString p ++ " " ++ path ++ " as=" ++ alias ++ a ++ concatStrings (map n names) ++ "\n"

dList : (a -> String) -> List a -> String
dList f xs = "[" ++ joinWith " " (mapList f xs) ++ "]"

dBool : Bool -> String
dBool True = "T"
dBool False = "F"

dSig : Sig -> String
dSig (Sig p n s priv) = "(sig " ++ posString p ++ " " ++ n ++ " " ++ dScheme s ++ " " ++ dBool priv ++ ")"

dDecl : Decl -> <IO> String
dDecl d = match d with
  DSig s -> dSig s
  DFun p b priv -> "(fun " ++ posString p ++ " " ++ dBind b ++ " " ++ dBool priv ++ ")"
  DType p n ps cs ds priv -> "(type " ++ posString p ++ " " ++ n ++ " " ++ dList id ps ++ " " ++ dList (\(CtorDecl cp cn fs) -> "(" ++ posString cp ++ " " ++ cn ++ " " ++ dList dType fs ++ ")") cs ++ " " ++ dList id ds ++ " " ++ dBool priv ++ ")"
  DAlias p n ps t -> "(alias " ++ posString p ++ " " ++ n ++ " " ++ dList id ps ++ " " ++ dType t ++ ")"
  DClass p n param supers sigs defs -> "(class " ++ posString p ++ " " ++ n ++ " " ++ param ++ " " ++ dList dPred supers ++ " " ++ dList dSig sigs ++ " " ++ dList dBind defs ++ ")"
  DInstance p ctx q c h bs _ -> "(instance " ++ posString p ++ " " ++ dList dPred ctx ++ " " ++ q ++ " " ++ c ++ " " ++ dType h ++ " " ++ dList dBind bs ++ ")"
  DEffect p n ps ops -> "(effect " ++ posString p ++ " " ++ n ++ " " ++ dList id ps ++ " " ++ dList dSig ops ++ ")"
  DForeign p n s t -> "(foreign " ++ posString p ++ " " ++ n ++ " " ++ dScheme s ++ " " ++ t ++ ")"
  DFixity p a pr ops -> "(fixity " ++ posString p ++ " " ++ show a ++ " " ++ show pr ++ " " ++ dList id ops ++ ")"
  DTest p n b _ -> "(test " ++ posString p ++ " " ++ show n ++ " " ++ dExpr b ++ ")"

dPred : PredE -> String
dPred (PredE p q c t) = "(pred " ++ posString p ++ " " ++ q ++ " " ++ c ++ " " ++ dType t ++ ")"

dScheme : SchemeE -> String
dScheme (SchemeE ps t) = "(scheme " ++ dList dPred ps ++ " " ++ dType t ++ ")"

dType : TypeExpr -> String
dType t = match t with
  TVarE p n -> "(tv " ++ posString p ++ " " ++ n ++ ")"
  TConE p q n -> "(tc " ++ posString p ++ " " ++ q ++ " " ++ n ++ ")"
  TAppE p f args -> "(tapp " ++ posString p ++ " " ++ dType f ++ " " ++ dList dType args ++ ")"
  TFunE p a r res ->
    let rs = match r with
      None -> "-"
      Some (RowE rp ls tl) -> "(row " ++ posString rp ++ " " ++ dList dType ls ++ " " ++ tl ++ ")"
    "(tfun " ++ posString p ++ " " ++ dType a ++ " " ++ rs ++ " " ++ dType res ++ ")"
  TTupleE p es -> "(ttuple " ++ posString p ++ " " ++ dList dType es ++ ")"
  TUnitE p -> "(tunit " ++ posString p ++ ")"

dLit : Lit -> String
dLit l = match l with
  LInt n -> "(int " ++ show n ++ ")"
  LFloat f -> "(float " ++ formatFloat f ++ ")"
  LString s -> "(str " ++ show s ++ ")"
  LChar c -> "(char " ++ show (charToString c) ++ ")"

dPat : Pattern -> String
dPat p = match p with
  PVar pos n _ -> "(pvar " ++ posString pos ++ " " ++ n ++ ")"
  PWild pos -> "(pwild " ++ posString pos ++ ")"
  PLit pos l -> "(plit " ++ posString pos ++ " " ++ dLit l ++ ")"
  PCon pos q n args _ -> "(pcon " ++ posString pos ++ " " ++ q ++ " " ++ n ++ " " ++ dList dPat args ++ ")"
  PTuple pos es -> "(ptuple " ++ posString pos ++ " " ++ dList dPat es ++ ")"
  PList pos es -> "(plist " ++ posString pos ++ " " ++ dList dPat es ++ ")"
  PAs pos n _ q -> "(pas " ++ posString pos ++ " " ++ n ++ " " ++ dPat q ++ ")"
  PUnit pos -> "(punit " ++ posString pos ++ ")"
  PAnnot pos q t -> "(pannot " ++ posString pos ++ " " ++ dPat q ++ " " ++ dType t ++ ")"

dRhs : Rhs -> <IO> String
dRhs (RBody e) = "(body " ++ dExpr e ++ ")"
dRhs (RGuards gs) = "(guards " ++ dList (\(Guard p c b) -> "(" ++ posString p ++ " " ++ dExpr c ++ " " ++ dExpr b ++ ")") gs ++ ")"

dBind : Bind -> <IO> String
dBind b =
  let pat = match bindPat b with
    Some q -> dPat q
    None -> "-"
  let sig = match bindSig b with
    Some s -> dScheme s
    None -> "-"
  let cl (Clause p ps r) = "(clause " ++ posString p ++ " " ++ dList dPat ps ++ " " ++ dRhs r ++ ")"
  "(bind " ++ posString (bindPos b) ++ " " ++ bindName b ++ " " ++ pat ++ " " ++ dList cl (bindClauses b) ++ " " ++ sig ++ ")"

dHC : HandlerClause -> <IO> String
dHC (HandlerClause p n ps b _) = "(hc " ++ posString p ++ " " ++ n ++ " " ++ dList dPat ps ++ " " ++ dExpr b ++ ")"

dOpt : Option Expr -> <IO> String
dOpt None = "-"
dOpt (Some e) = dExpr e

dExpr : Expr -> <IO> String
dExpr e = match e with
  ELit p l -> "(lit " ++ posString p ++ " " ++ dLit l ++ ")"
  EVar p q n _ _ -> "(var " ++ posString p ++ " " ++ q ++ " " ++ n ++ ")"
  ECon p q n _ -> "(con " ++ posString p ++ " " ++ q ++ " " ++ n ++ ")"
  EApp p f args _ -> "(app " ++ posString p ++ " " ++ dExpr f ++ " " ++ dList dExpr args ++ ")"
  ELam p ps b -> "(lam " ++ posString p ++ " " ++ dList dPat ps ++ " " ++ dExpr b ++ ")"
  ELet p bs b -> "(let " ++ posString p ++ " " ++ dList dBind bs ++ " " ++ dExpr b ++ ")"
  EBlock p ss ->
    let st s = match s with
      SExpr x -> "(sexpr " ++ dExpr x ++ ")"
      SLet b -> "(slet " ++ dBind b ++ ")"
    "(block " ++ posString p ++ " " ++ dList st ss ++ ")"
  EMatch p s arms -> "(match " ++ posString p ++ " " ++ dExpr s ++ " " ++ dList (\(Arm ap pat r) -> "(arm " ++ posString ap ++ " " ++ dPat pat ++ " " ++ dRhs r ++ ")") arms ++ ")"
  EHandle p b ret ops _ ->
    let r = match ret with
      Some hc -> dHC hc
      None -> "-"
    "(handle " ++ posString p ++ " " ++ dExpr b ++ " " ++ r ++ " " ++ dList dHC ops ++ ")"
  ETuple p es -> "(tuple " ++ posString p ++ " " ++ dList dExpr es ++ ")"
  EList p es -> "(list " ++ posString p ++ " " ++ dList dExpr es ++ ")"
  EUnit p -> "(unit " ++ posString p ++ ")"
  EOpChain p es ops -> "(chain " ++ posString p ++ " " ++ dList dExpr es ++ " " ++ dList dExpr ops ++ ")"
  EBinOp p op l r -> "(binop " ++ posString p ++ " " ++ dExpr op ++ " " ++ dExpr l ++ " " ++ dExpr r ++ ")"
  ENeg p x -> "(neg " ++ posString p ++ " " ++ dExpr x ++ ")"
  ESection p op l r -> "(section " ++ posString p ++ " " ++ dExpr op ++ " " ++ dOpt l ++ " " ++ dOpt r ++ ")"
  EInterp p ps -> "(interp " ++ posString p ++ " " ++ dList dExpr ps ++ ")"
  EAnnot p x s -> "(annot " ++ posString p ++ " " ++ dExpr x ++ " " ++ dScheme s ++ ")"
