import Std.State (..)
import Std.Reader (..)
import Std.Writer (..)
import Std.Exn (..)
import Std.Map as Map
import Std.Set as Set
import Std.Array as Array
import Std.Random (..)
import Std.Bits (..)
import Std.String as S

type Config = Config Int String

tick : Unit -> <State Int, Writer (List String)> Unit
tick () =
  modify (+ 1)
  tell ["tick ${get ()}"]

greeting : Unit -> <Reader Config> String
greeting () =
  let Config n name = ask ()
  S.repeat n "hi " ++ name

parseAge : String -> <Exn String> Int
parseAge s = match parseInt s with
  Some n | n >= 0 -> n
  _ -> throw "invalid age: ${s}"

wordFreq : String -> Map.Map String Int
wordFreq text = foldl (\m w -> Map.insertWith (+) w 1 m) Map.empty (words text)

main () =
  -- effects from the standard library
  let ((_, logs), n) = runState 0 (\_ -> runWriter (\_ -> tick (); tick (); tick ()))
  printLn (n, logs)
  println (runReader (Config 2 "Arkadia") greeting)
  printLn (try (\_ -> parseAge "42"))
  printLn (try (\_ -> parseAge "-1"))
  printLn (catchExn (\_ -> parseAge "x") (\_ -> 0))
  -- maps and sets
  let freq = wordFreq "the quick brown fox jumps over the lazy dog the end"
  printLn (Map.lookup "the" freq, Map.lookup "cat" freq, length freq)
  printLn (Map.toList (Map.filter (> 1) freq))
  let m = Map.fromList (map (\i -> (i, i * i)) [1 .. 1000])
  printLn (length m, Map.lookup 500 m, sum (Map.values (Map.delete 1000 m)))
  printLn (Map.keys (map (* 2) (Map.fromList [(3, 1), (1, 2), (2, 3)])))
  let s = Set.fromList [5, 1, 3, 1, 5, 9]
  printLn (toList s, Set.member 3 s, Set.member 4 s)
  printLn (Set.union s (Set.fromList [2, 4]))
  printLn (Set.intersection s (Set.fromList [1, 9, 10]))
  -- arrays
  let arr = Array.generate 10 (\i -> i * i)
  printLn (Array.get 3 arr, Array.get 10 arr, length arr)
  printLn (Array.set 0 100 arr |> toList |> take 3)
  printLn (Array.sort (Array.fromList [3, 1, 2]))
  printLn (sum arr)
  -- deterministic random numbers
  let rolls = runRandom 42 (\_ -> map (\_ -> randomInt 1 6) [1 .. 10])
  printLn (all (\r -> r >= 1 && r <= 6) rolls, length rolls)
  printLn (runRandom 7 (\_ -> randomInt 1 1000) == runRandom 7 (\_ -> randomInt 1 1000))
  -- bits and strings
  printLn (12 .&. 10, 12 .|. 3, 1 <<< 10, popCount 255)
  printLn (S.padLeft 5 '0' "42", S.capitalize "arkadia", S.reverse "abc", S.indexOf "lo" "hello")
