-- Arithmetic, strings, interpolation and lists
square x = x * x

main () =
  println "1 + 2 * 3 = ${1 + 2 * 3}"
  println "10 / 3 = ${10 / 3}, 10 % 3 = ${10 % 3}, -7 % 3 = ${-7 % 3}"
  println "float: ${1.5 * 2.0} ${toFloat 3 / 2.0}"
  println "square 12 = ${square 12}"
  let xs = [1 .. 10]
  println "sum = ${sum xs}, product = ${product [1, 2, 3, 4]}"
  printLn (map square (filter even xs))
  printLn (reverse xs |> take 3)
  printLn (zip [1, 2, 3] ["a", "b", "c"])
  printLn (sort [5, 3, 9, 1, 4])
  printLn (sortOn negate [5, 3, 9, 1, 4])
  println (joinWith ", " (words "  hello   functional world "))
  printLn (chars "abc")
  println (toUpper "arkadia" ++ "!")
  printLn (parseInt "42", parseInt "x")
  printLn (length (replicate 5 'x'), nth 2 [10, 20, 30])
  printLn (foldr (\x acc -> x :: acc) [] [1, 2, 3])
  printLn (lookup 2 [(1, "one"), (2, "two")])
  printLn (maximum [3, 1, 4], minimum ([] : List Int))
  printLn (show 3.0, show (-2), show "q\"uote", show 'c')
  printLn (compare 1 2, max "a" "b", [1, 2] < [1, 3])
  printLn ((1, 'a') == (1, 'a'), Some 3 != None)
  printLn (all even [2, 4], any odd [2, 4], elem 3 [1, 2, 3])
  printLn ([1, 2] ++ [3], "ab" ++ "cd")
  printLn (concatMap (\x -> [x, x]) [1, 2])
  printLn (nub [1, 1, 2, 3, 2], intersperse 0 [1, 2, 3])
  println "${(+ 1) 2} ${(10 -) 4} ${(`mod` 4) 10}"
