-- Type classes: superclasses, defaults, contexts, higher kinds
class Shape a where
  area : a -> Float
  name : a -> String
  describe : a -> String
  describe s = "${name s} with area ${area s}"

type Circle = Circle Float
type Rect = Rect Float Float

instance Shape Circle where
  area (Circle r) = 3.0 * r * r
  name _ = "circle"

instance Shape Rect where
  area (Rect w h) = w * h
  name _ = "rect"
  describe r = "a rectangle of area ${area r}"

class Shape a => Solid a where
  volume : a -> Float -> Float
  volume s h = area s * h

instance Solid Rect

type Pair a = Pair a a
  deriving (Show, Eq, Ord)

instance Functor Pair where
  map f (Pair x y) = Pair (f x) (f y)

instance Foldable Pair where
  foldr f z (Pair x y) = f x (f y z)
  foldl f z (Pair x y) = f (f z x) y

type Tree a = Leaf | Node (Tree a) a (Tree a)
  deriving (Show, Eq)

insert : Ord a => a -> Tree a -> Tree a
insert x Leaf = Node Leaf x Leaf
insert x (Node l v r)
  | x < v = Node (insert x l) v r
  | x > v = Node l v (insert x r)
  | otherwise = Node l v r

instance Foldable Tree where
  foldr _ z Leaf = z
  foldr f z (Node l v r) = foldr f (f v (foldr f z r)) l
  foldl _ z Leaf = z
  foldl f z (Node l v r) = foldl f (f (foldl f z l) v) r

instance Functor Tree where
  map _ Leaf = Leaf
  map f (Node l v r) = Node (map f l) (f v) (map f r)

-- a generic function over any Functor
twiceAll : Functor f => f Int -> f Int
twiceAll = map (* 2)

type Color = Red | Green | Blue
  deriving (Show, Eq, Ord)

main () =
  println (describe (Circle 1.0))
  println (describe (Rect 2.0 3.0))
  printLn (volume (Rect 2.0 3.0) 10.0)
  printLn (twiceAll (Pair 1 2))
  printLn (twiceAll (Some 21))
  printLn (twiceAll [1, 2, 3])
  printLn (sum (Pair 3 4))
  let t = foldl (\acc x -> insert x acc) Leaf [5, 2, 8, 1, 9, 3]
  printLn (toList t)
  printLn (sum (map (* 10) t))
  printLn (Pair 1 2 == Pair 1 2, Pair 1 2 < Pair 1 3)
  printLn (sort [Blue, Red, Green], Red < Blue)
  printLn (insert 1 Leaf)
  printLn (Some 1 >>= (\x -> Some (x + 1)))
  printLn ([1, 2] >>= (\x -> [x, x * 10]))
  printLn (map (+ 1) (Ok 1 : Result String Int))
  printLn (traverse (\x -> if0 x) [1, 2, 3])
  printLn (traverse (\x -> if0 x) [1, 0, 3])
  printLn (sequence [Some 1, Some 2])

if0 : Int -> Option Int
if0 0 = None
if0 x = Some x
