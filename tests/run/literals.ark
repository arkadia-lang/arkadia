-- Integer literals become Floats where a Float is expected.

area : Float -> Float
area r = 3 * r * r

mean : List Float -> Float
mean xs = sum xs / toFloat (length xs)

type Point = Point { x : Float, y : Float }
  deriving Show

-- without other information a literal is an Int
half x = x / 2

main () =
  println (show (area 2))
  println (show [1.5, 2, -3])
  println (show (mean [1, 2, 4]))
  println (show (Point { x = 1, y = 0 }))
  let scale = 2.5
  println (show (scale * 4, 4 * scale, max 0 (scale - 3)))
  println (show (half 7))
  println (show (map (\v -> v * 10) [0.5, 1]))
  println "${1 + 2} ${0.5 + 1}"
