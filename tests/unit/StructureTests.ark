-- Unit tests for Std.Queue, Std.Heap and Std.Ord.
module StructureTests

import Std.Queue
import Std.Heap
import Std.Ord

-- Pop every element from the front.
drainQueue : Queue.Queue a -> List a
drainQueue q = match Queue.pop q with
  None -> []
  Some (x, rest) -> x :: drainQueue rest

drainBack : Queue.Queue a -> List a
drainBack q = match Queue.popBack q with
  None -> []
  Some (x, rest) -> x :: drainBack rest

test "queue is first in, first out" =
  let q = foldl (\q x -> Queue.push x q) Queue.empty [1 .. 5]
  assertEq (drainQueue q) [1, 2, 3, 4, 5]
  assertEq (Queue.size q, Queue.peek q, Queue.peekBack q) (5, Some 1, Some 5)
  assertEq (Queue.pop (Queue.empty : Queue.Queue Int)) None

test "queue works from both ends" =
  let q = Queue.pushFront 0 (Queue.push 4 (Queue.fromList [1, 2, 3]))
  assertEq (Queue.toList q) [0, 1, 2, 3, 4]
  assertEq (drainBack q) [4, 3, 2, 1, 0]
  assertEq (drainBack (Queue.fromList [1, 2, 3])) [3, 2, 1]
  assertEq (drainQueue (Queue.reverse q)) [4, 3, 2, 1, 0]

test "queue alternating ends" =
  let q = Queue.fromList [1 .. 6]
  let take2 q = match Queue.pop q with
    Some (a, q2) -> match Queue.popBack q2 with
      Some (b, q3) -> (a, b, Queue.size q3)
      None -> (a, 0, 0)
    None -> (0, 0, 0)
  assertEq (take2 q) (1, 6, 4)

test "queue instances" =
  let q = Queue.fromList [1, 2, 3]
  assertEq (sum q, Queue.toList (map (* 2) q)) (6, [2, 4, 6])
  assertEq (Queue.append q (Queue.singleton 4) == Queue.fromList [1, 2, 3, 4]) True
  assertEq (show q) "Queue.fromList [1, 2, 3]"

test "heap yields elements in order" =
  let xs = [5, 3, 9, 1, 7, 3, 8, 2]
  let h = Heap.fromList xs
  assertEq (Heap.toSortedList h) (sort xs)
  assertEq (Heap.size h, Heap.peek h) (8, Some 1)
  assertEq (Heap.take 3 h) [1, 2, 3]
  assertEq (Heap.toSortedList (Heap.deleteMin h)) [2, 3, 3, 5, 7, 8, 9]

test "heap merge" =
  let h = Heap.merge (Heap.fromList [4, 1]) (Heap.fromList [3, 2])
  assertEq (Heap.toSortedList h) [1, 2, 3, 4]
  assert (Heap.isEmpty (Heap.empty : Heap.Heap Int)) "empty"
  assertEq (Heap.pop (Heap.empty : Heap.Heap Int)) None

test "large heap sort" =
  let xs = map (\i -> (i * 7919) % 1000) [1 .. 1000]
  assertEq (Heap.toSortedList (Heap.fromList xs)) (sort xs)

test "max heap with Down" =
  let h = Heap.fromList (map Down [2, 9, 4])
  assertEq (map getDown (Heap.toSortedList h)) [9, 4, 2]

test "ordering helpers" =
  let ps = [(2, 'b'), (1, 'c'), (2, 'a')]
  assertEq (sortBy (comparing snd) ps) [(2, 'a'), (2, 'b'), (1, 'c')]
  assertEq (sortBy (reverseOrder compare) [1, 3, 2]) [3, 2, 1]
  assertEq (sortBy (thenComparing (comparing fst) (reverseOrder (comparing snd))) ps) [(1, 'c'), (2, 'b'), (2, 'a')]
  assertEq (sortOn (\p -> Down (fst p)) ps) [(2, 'b'), (2, 'a'), (1, 'c')]
  assert (between 1 3 2 && not (between 1 3 4)) "between"

test "queues and heaps are monoids and interpolate" =
  assertEq (Queue.toList (Queue.fromList [1, 2] <> Queue.fromList [3])) [1, 2, 3]
  assertEq (Heap.toSortedList (Heap.fromList [5, 1] <> Heap.fromList [3])) [1, 3, 5]
  assertEq "${Queue.fromList [1]} ${Heap.fromList [2]}" "Queue.fromList [1] Heap.fromList [2]"
