-- Unit tests for Std.String and Std.Char.
module StringTests

import Std.String as S
import Std.Char as Char

test "char classification" =
  assert (Char.isAlphaNum 'a' && Char.isAlphaNum '7' && not (Char.isAlphaNum '-')) "isAlphaNum"
  assert (Char.isPunctuation '!' && Char.isPunctuation '+' && not (Char.isPunctuation 'x')) "isPunctuation"
  assert (Char.isAscii 'z' && not (Char.isAscii 'é')) "isAscii"
  assert (Char.isHexDigit 'F' && not (Char.isHexDigit 'g') && Char.isOctDigit '7') "hex / oct"
  assert (Char.isControl '\n' && Char.isPrint 'a') "control / print"

test "char conversion" =
  assertEq (Char.toUpper 'ä', Char.toLower 'Q') ('Ä', 'q')
  assertEq (map Char.digitToInt ['0', 'a', 'F', 'z']) [Some 0, Some 10, Some 15, None]
  assertEq (Char.intToDigit 11, Char.intToDigit 16) (Some 'b', None)

test "searching" =
  assertEq (S.indexOf "b" "abcb", S.lastIndexOf "b" "abcb") (Some 1, Some 3)
  assertEq (S.lastIndexOf "語" "日本語") (Some 2)
  assertEq (S.splitOnce "=" "k=v=w", S.splitOnce ":" "kv") (Some ("k", "v=w"), None)
  assertEq (S.occurrences "aa" "aaaaa") 2

test "slicing" =
  assertEq (S.take 2 "日本語", S.drop 2 "日本語") ("日本", "語")
  assertEq (S.takeEnd 2 "hello", S.dropEnd 2 "hello") ("lo", "hel")
  assertEq (S.take 10 "ab", S.drop 10 "ab") ("ab", "")
  assertEq (S.stripPrefix "foo" "foobar", S.stripSuffix "x" "foobar") (Some "bar", None)

test "editing" =
  assertEq (S.replaceFirst "a" "o" "banana") "bonana"
  assertEq (S.trimChars "-*" "--a*b*-") "a*b"
  assertEq (S.center 7 '*' "ab") "**ab***"
  assertEq (S.uncapitalize "Hello", S.capitalize "hello") ("hello", "Hello")

test "predicates and lines" =
  assert (S.isBlank " \t" && not (S.isBlank " x")) "isBlank"
  assert (S.equalIgnoringCase "Straße" "STRASSE" == False && S.equalIgnoringCase "Go" "gO") "equalIgnoringCase"
  assertEq (S.byteLength "é", stringLength "é") (2, 1)
  assertEq (S.splitLines "a\r\nb\nc") ["a", "b", "c"]

test "wrap" =
  assertEq (S.wrap 10 "the quick brown fox jumps over") ["the quick", "brown fox", "jumps over"]
  assertEq (S.wrap 3 "abcdef gh") ["abcdef", "gh"]
  assertEq (S.wrap 5 "  ") []
